# No line-ending conversion: files are checked out exactly as committed (LF), whatever
# core.autocrlf says. The Claude plugin directory rejects attributes that rewrite content.
* -text
*.ttf binary
*.png binary
*.wasm binary
*.pptx binary
*.pdf binary
dist/** linguist-generated=true -diff
docs/reference/*.gen.md linguist-generated=true
package-lock.json linguist-generated=true -diff
