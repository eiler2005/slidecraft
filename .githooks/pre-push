#!/bin/sh
# SlideCraft pre-push: refuse refs/heads/local/*, privacy-check every commit being pushed.
# git feeds lines on stdin: <local ref> <local sha> <remote ref> <remote sha>
set -e
# Fall back to the system git if a stale single-arch git is first on PATH.
GIT="${GIT_BIN:-git}"
"$GIT" --version >/dev/null 2>&1 || GIT=/usr/bin/git
cd "$("$GIT" rev-parse --show-toplevel)"
HOOKS="$(dirname "$0")"
ZERO=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref $remote_ref" in
    refs/heads/local/*|*" refs/heads/local/"*)
      echo "pre-push: refusing to push '$local_ref' -> '$remote_ref'; local/* branches stay on this machine." >&2
      exit 1
      ;;
  esac
  [ "$local_sha" = "$ZERO" ] && continue # branch deletion

  if [ "$remote_sha" = "$ZERO" ] || ! "$GIT" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    commits="$("$GIT" rev-list "$local_sha" --not --remotes)"
  else
    commits="$("$GIT" rev-list "$remote_sha..$local_sha")"
  fi

  for sha in $commits; do
    "$HOOKS/privacy-check" commit "$sha" || status=1
  done
done

exit $status
