{
  "version": "0.4.0",
  "layouts": [
    {
      "id": "title",
      "name": "Title",
      "group": "frame",
      "variants": [
        "cover",
        "closing"
      ],
      "purpose": "Use for the cover that frames the deck, or a closing slide with the ask and contacts.",
      "frame": "none"
    },
    {
      "id": "agenda",
      "name": "Agenda and section divider",
      "group": "frame",
      "variants": [
        "agenda",
        "section-divider"
      ],
      "purpose": "Use for the agenda at the start of a deck, or a section divider that shows where the audience is in the story.",
      "frame": "none"
    },
    {
      "id": "exec-summary",
      "name": "Executive summary",
      "group": "message",
      "variants": [
        "scr",
        "key-messages"
      ],
      "purpose": "Use for the answer-first summary: the whole argument on one page, readable without the rest of the deck.",
      "frame": "standard"
    },
    {
      "id": "key-points",
      "name": "Key points",
      "group": "message",
      "variants": [
        "columns",
        "cards",
        "list"
      ],
      "purpose": "Use for two to four parallel points that together prove the title, each with a short heading, support and an optional proof number.",
      "frame": "standard"
    },
    {
      "id": "big-statement",
      "name": "Big statement",
      "group": "message",
      "variants": [
        "statement",
        "quote",
        "hero-number"
      ],
      "purpose": "Use for the one thing the audience must remember: a single bold statement, a customer quote or one hero number, with room to breathe.",
      "frame": "none"
    },
    {
      "id": "text-image",
      "name": "Text and image",
      "group": "message",
      "variants": [
        "image-right",
        "image-left"
      ],
      "purpose": "Use for a story beat that needs a photo or illustration next to a few short paragraphs, such as a customer case or a site visit.",
      "frame": "standard"
    },
    {
      "id": "text",
      "name": "Text",
      "group": "message",
      "variants": [
        "bullets",
        "paragraphs",
        "two-column"
      ],
      "purpose": "Use for plain text when no exhibit fits — bullets, short paragraphs or two columns. Also where imported slides land.",
      "frame": "standard"
    },
    {
      "id": "before-after",
      "name": "Before and after",
      "group": "message",
      "variants": [
        "panels"
      ],
      "purpose": "Use for a change told as two states — how things are today and how they will be — with one number on each side.",
      "frame": "standard"
    },
    {
      "id": "freeform",
      "name": "Freeform HTML",
      "group": "message",
      "variants": [
        "body"
      ],
      "purpose": "Use for a creative, story-led exhibit no layout covers: HTML and CSS inside the standard frame, checked for overflow and text size like every other slide.",
      "frame": "standard"
    },
    {
      "id": "kpi-tiles",
      "name": "KPI tiles",
      "group": "numbers",
      "variants": [
        "tiles",
        "strip"
      ],
      "purpose": "Use for 2–4 headline numbers that prove the title at a glance, each with its label, change and context.",
      "frame": "standard"
    },
    {
      "id": "chart-takeaway",
      "name": "Chart with takeaway",
      "group": "numbers",
      "variants": [
        "bar",
        "column",
        "stacked",
        "line"
      ],
      "purpose": "Use for one chart that proves the title, with the interpretation in a side panel.",
      "frame": "standard"
    },
    {
      "id": "waterfall",
      "name": "Waterfall",
      "group": "numbers",
      "variants": [
        "full",
        "with-takeaway"
      ],
      "purpose": "Use for a bridge that explains how a starting total becomes an ending total through positive and negative drivers.",
      "frame": "standard"
    },
    {
      "id": "funnel",
      "name": "Funnel / pyramid",
      "group": "numbers",
      "variants": [
        "funnel",
        "pyramid"
      ],
      "purpose": "Use for a conversion funnel (where volume is lost) or a pyramid (levels that build on each other).",
      "frame": "standard"
    },
    {
      "id": "data-table",
      "name": "Data table",
      "group": "numbers",
      "variants": [
        "plain",
        "with-takeaway"
      ],
      "purpose": "Use for a compact table of exact values where the reader needs to look up or compare several attributes at once.",
      "frame": "standard"
    },
    {
      "id": "options-comparison",
      "name": "Options comparison",
      "group": "decide",
      "variants": [
        "text",
        "rating"
      ],
      "purpose": "Use for comparing 2–5 options on the same criteria and showing which one wins and why.",
      "frame": "standard"
    },
    {
      "id": "matrix-2x2",
      "name": "2×2 matrix",
      "group": "decide",
      "variants": [
        "plot",
        "quadrants"
      ],
      "purpose": "Use for prioritising items on two dimensions, or naming four strategic positions.",
      "frame": "standard"
    },
    {
      "id": "issue-tree",
      "name": "Issue / driver tree",
      "group": "decide",
      "variants": [
        "issue",
        "driver"
      ],
      "purpose": "Use for breaking a question into MECE sub-questions (issue tree) or a metric into its drivers (driver tree).",
      "frame": "standard"
    },
    {
      "id": "maturity-model",
      "name": "Maturity model",
      "group": "decide",
      "variants": [
        "grid",
        "staircase"
      ],
      "purpose": "Use for showing where an organisation stands on a maturity scale and where it should get to — one capability as a staircase, or several on one grid.",
      "frame": "standard"
    },
    {
      "id": "coverage-map",
      "name": "Coverage map",
      "group": "decide",
      "variants": [
        "grid"
      ],
      "purpose": "Use for showing the state of many functions at once on stable geometry — what is covered, partly covered, planned or missing.",
      "frame": "standard"
    },
    {
      "id": "architecture",
      "name": "Architecture with register",
      "group": "decide",
      "variants": [
        "zones"
      ],
      "purpose": "Use for showing where in a system a problem sits and what to do about it: components in zones, requests and responses, and a numbered register linked to markers on the diagram.",
      "frame": "standard"
    },
    {
      "id": "evidence-chain",
      "name": "Evidence chain",
      "group": "decide",
      "variants": [
        "chain"
      ],
      "purpose": "Use for showing what an answer rests on: each check, its source and its result in order, ending in the conclusion and what would overturn it.",
      "frame": "standard"
    },
    {
      "id": "risk-matrix",
      "name": "Risk heatmap",
      "group": "decide",
      "variants": [
        "heatmap"
      ],
      "purpose": "Use for showing the main risks by likelihood and impact, with owners and mitigations.",
      "frame": "standard"
    },
    {
      "id": "process-steps",
      "name": "Process steps",
      "group": "sequence",
      "variants": [
        "chevrons",
        "numbered"
      ],
      "purpose": "Use for a sequence of 3–6 steps where order matters — an approach, a method or a customer journey.",
      "frame": "standard"
    },
    {
      "id": "timeline",
      "name": "Timeline",
      "group": "sequence",
      "variants": [
        "milestones",
        "gantt"
      ],
      "purpose": "Use for dated milestones or a phased roadmap on one shared time axis.",
      "frame": "standard"
    },
    {
      "id": "gate-matrix",
      "name": "Stages and gates",
      "group": "sequence",
      "variants": [
        "gates"
      ],
      "purpose": "Use for a stage-gate plan: what each stage delivers and what evidence opens the next one, and who decides.",
      "frame": "standard"
    },
    {
      "id": "process-compare",
      "name": "Current vs proposed process",
      "group": "sequence",
      "variants": [
        "lanes"
      ],
      "purpose": "Use for showing what changes in a process: today’s steps against the proposed ones, with changed steps highlighted.",
      "frame": "standard"
    },
    {
      "id": "cadence",
      "name": "Role calendar",
      "group": "sequence",
      "variants": [
        "grid"
      ],
      "purpose": "Use for showing who takes part when: roles or forums against a shared calendar, with recurring meetings, decisions, outputs and work periods.",
      "frame": "standard"
    },
    {
      "id": "callout",
      "name": "Callouts and steps",
      "group": "sequence",
      "variants": [
        "image-left"
      ],
      "purpose": "Use for showing someone how to do something on a screen or object: numbered callouts on the picture, the action and expected result for each, and how to check it worked.",
      "frame": "standard"
    },
    {
      "id": "team-cards",
      "name": "Team cards",
      "group": "people",
      "variants": [
        "cards",
        "compact"
      ],
      "purpose": "Use for introducing the people behind a proposal: who leads, who delivers, who the client sponsors are.",
      "frame": "standard"
    },
    {
      "id": "org-chart",
      "name": "Org chart",
      "group": "people",
      "variants": [
        "tree"
      ],
      "purpose": "Use for a reporting structure two levels deep: who leads, which units report to them and who sits in each.",
      "frame": "standard"
    },
    {
      "id": "raci",
      "name": "RACI / decision rights",
      "group": "people",
      "variants": [
        "raci"
      ],
      "purpose": "Use for showing who is Responsible, Accountable, Consulted and Informed for each decision or activity.",
      "frame": "standard"
    },
    {
      "id": "next-steps",
      "name": "Next steps",
      "group": "close",
      "variants": [
        "actions",
        "decision"
      ],
      "purpose": "Use for the closing slide that turns the recommendation into owned, dated actions, with or without the decision requested.",
      "frame": "standard"
    }
  ],
