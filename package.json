{
  "name": "@eiler2005/slidecraft",
  "version": "0.5.3",
  "description": "Describe the goal. Pick a look. Ship a partner-ready deck. A Claude Code plugin and CLI that turns a brief into editable PPTX, vector PDF and HTML decks.",
  "type": "module",
  "license": "MIT",
  "author": "Denis Ermilov",
  "homepage": "https://github.com/eiler2005/slidecraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eiler2005/slidecraft.git"
  },
  "keywords": [
    "presentations",
    "slides",
    "pptx",
    "pdf",
    "consulting",
    "claude-code-plugin",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "slidecraft": "dist/slidecraft.mjs"
  },
  "files": [
    "dist/",
    "fonts/",
    "library/",
    "schemas/",
    "skills/",
    "agents/",
    "codex/",
    ".claude-plugin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "AGENTS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts",
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "gen": "tsx src/cli/main.ts gen",
    "check": "npm run lint && npm run typecheck && npm run test",
    "hooks": "node -e \"require('child_process').execFileSync(process.platform==='darwin'&&require('fs').existsSync('/usr/bin/git')?'/usr/bin/git':'git',['config','core.hooksPath','.githooks'],{stdio:'inherit'})\"",
    "prepublishOnly": "node scripts/prepublish.mjs",
    "showcase": "tsx scripts/showcase.ts",
    "test:digital-ruble": "tsx scripts/digital-ruble-regression.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/fontkit": "2.0.9",
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.6",
    "commander": "15.0.0",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "jszip": "3.10.2",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "0.20.2",
    "pptxgenjs": "4.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  }
}
