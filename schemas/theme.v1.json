{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "One sentence: the look and what it is best for"
    },
    "bestFor": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Storyline ids or task words this theme suits"
    },
    "mood": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dark": {
      "default": false,
      "type": "boolean"
    },
    "prefers": {
      "default": "pptx",
      "description": "Engine that shows this theme best",
      "type": "string",
      "enum": [
        "pptx",
        "html"
      ]
    },
    "colors": {
      "type": "object",
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color, #RRGGBB"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Cards, panels, table header fill"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Primary text"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Secondary text, labels, axis"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "The one highlight color"
        },
        "accentText": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Text placed on accent fills"
        },
        "accentSoft": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Tinted accent for backgrounds and bands"
        },
        "rule": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hairlines, borders, gridlines"
        },
        "positive": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color, #RRGGBB"
        },
        "negative": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "Hex color, #RRGGBB"
        },
        "titleInk": {
          "description": "Action title color; defaults to ink",
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "background",
        "surface",
        "ink",
        "muted",
        "accent",
        "accentText",
        "accentSoft",
        "rule",
        "positive",
        "negative"
      ],
      "additionalProperties": false
    },
    "chart": {
      "minItems": 4,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "description": "Hex color, #RRGGBB"
      },
      "description": "Series palette; index 0 is the highlight series, the rest recede"
    },
    "fonts": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "description": "Font family written into PPTX/HTML, e.g. \"Arial\""
            },
            "measure": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "Bundled metric-compatible font used for measuring and PDF/PNG"
            },
            "files": {
              "description": "Brand font files (TTF/OTF), relative to the theme file; registers `measure` as a new measure font",
              "type": "object",
              "properties": {
                "regular": {
                  "type": "string"
                },
                "bold": {
                  "type": "string"
                },
                "italic": {
                  "type": "string"
                },
                "boldItalic": {
                  "type": "string"
                }
              },
              "required": [
                "regular"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "family",
            "measure"
          ],
          "additionalProperties": false
        },
        "body": {
          "type": "object",
          "properties": {
            "family": {
              "type": "string",
              "description": "Font family written into PPTX/HTML, e.g. \"Arial\""
            },
            "measure": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$",
              "description": "Bundled metric-compatible font used for measuring and PDF/PNG"
            },
            "files": {
              "description": "Brand font files (TTF/OTF), relative to the theme file; registers `measure` as a new measure font",
              "type": "object",
              "properties": {
                "regular": {
                  "type": "string"
                },
                "bold": {
                  "type": "string"
                },
                "italic": {
                  "type": "string"
                },
                "boldItalic": {
                  "type": "string"
                }
              },
              "required": [
                "regular"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "family",
            "measure"
          ],
          "additionalProperties": false
        },
        "cyrillic": {
          "description": "Override when deck text contains Cyrillic and the default lacks glyphs",
          "type": "object",
          "properties": {
            "heading": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "description": "Font family written into PPTX/HTML, e.g. \"Arial\""
                },
                "measure": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$",
                  "description": "Bundled metric-compatible font used for measuring and PDF/PNG"
                },
                "files": {
                  "description": "Brand font files (TTF/OTF), relative to the theme file; registers `measure` as a new measure font",
                  "type": "object",
                  "properties": {
                    "regular": {
                      "type": "string"
                    },
                    "bold": {
                      "type": "string"
                    },
                    "italic": {
                      "type": "string"
                    },
                    "boldItalic": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "regular"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "family",
                "measure"
              ],
              "additionalProperties": false
            },
            "body": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "description": "Font family written into PPTX/HTML, e.g. \"Arial\""
                },
                "measure": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$",
                  "description": "Bundled metric-compatible font used for measuring and PDF/PNG"
                },
                "files": {
                  "description": "Brand font files (TTF/OTF), relative to the theme file; registers `measure` as a new measure font",
                  "type": "object",
                  "properties": {
                    "regular": {
                      "type": "string"
                    },
                    "bold": {
                      "type": "string"
                    },
                    "italic": {
                      "type": "string"
                    },
                    "boldItalic": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "regular"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "family",
                "measure"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "heading",
        "body"
      ],
      "additionalProperties": false
    },
    "type": {
      "type": "object",
      "properties": {
        "cover": {
          "type": "number",
          "minimum": 24,
          "maximum": 72
        },
        "title": {
          "type": "number",
          "minimum": 16,
          "maximum": 36,
          "description": "Action title size, pt"
        },
        "subtitle": {
          "type": "number",
          "minimum": 11,
          "maximum": 24
        },
        "heading": {
          "type": "number",
          "minimum": 11,
          "maximum": 24
        },
        "body": {
          "type": "number",
          "minimum": 10,
          "maximum": 22
        },
        "minBody": {
          "type": "number",
          "minimum": 9,
          "maximum": 18,
          "description": "Smallest size copy-fitting may use"
        },
        "small": {
          "type": "number",
          "minimum": 8,
          "maximum": 14
        },
        "source": {
          "type": "number",
          "minimum": 7,
          "maximum": 11
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.6,
          "description": "Exact line spacing as multiple of size"
        },
        "titleWeight": {
          "default": "bold",
          "type": "string",
          "enum": [
            "regular",
            "bold"
          ]
        }
      },
      "required": [
        "cover",
        "title",
        "subtitle",
        "heading",
        "body",
        "minBody",
        "small",
        "source",
        "lineHeight",
        "titleWeight"
      ],
      "additionalProperties": false
    },
    "decor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "none",
            "rule",
            "wave",
            "glow",
            "geo",
            "gradient",
            "paper"
          ]
        },
        "colors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$",
            "description": "Hex color, #RRGGBB"
          }
        },
        "intensity": {
          "default": 0.6,
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "onContent": {
          "default": false,
          "description": "Also draw decor on content slides",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "colors",
        "intensity",
        "onContent"
      ],
      "additionalProperties": false
    },
    "chrome": {
      "type": "object",
      "properties": {
        "titleRule": {
          "default": false,
          "description": "Hairline under action titles",
          "type": "boolean"
        },
        "accentBar": {
          "default": false,
          "description": "Short accent bar above titles",
          "type": "boolean"
        },
        "pageNumbers": {
          "default": true,
          "type": "boolean"
        },
        "footer": {
          "description": "Default footer text; decks can override",
          "type": "string"
        },
        "tracker": {
          "default": true,
          "description": "Small section label top-left",
          "type": "boolean"
        },
        "canvasFrame": {
          "description": "Opt canvas layouts into the shared theme frame; standard preserves title, sources and numbering",
          "type": "string",
          "enum": [
            "none",
            "standard"
          ]
        },
        "sideRail": {
          "description": "Editable full-height accent rail, inches",
          "type": "object",
          "properties": {
            "width": {
              "default": 0.12,
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 0.5
            },
            "radius": {
              "default": 0.06,
              "type": "number",
              "minimum": 0,
              "maximum": 0.25
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Hex color, #RRGGBB"
            }
          },
          "required": [
            "width",
            "radius"
          ],
          "additionalProperties": false
        },
        "markerWithTracker": {
          "description": "Keep the accent marker beside the section label",
          "type": "boolean"
        },
        "pageBadge": {
          "description": "Header page number in an editable rounded badge instead of the footer field",
          "type": "object",
          "properties": {
            "fill": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Hex color, #RRGGBB"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Hex color, #RRGGBB"
            },
            "minDigits": {
              "default": 2,
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            }
          },
          "required": [
            "minDigits"
          ],
          "additionalProperties": false
        },
        "sources": {
          "description": "Shared source-line styling; citation text and links remain slide data",
          "type": "object",
          "properties": {
            "visible": {
              "default": true,
              "type": "boolean"
            },
            "prefix": {
              "default": "Source:",
              "type": "string",
              "maxLength": 32
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Hex color, #RRGGBB"
            },
            "size": {
              "type": "number",
              "minimum": 7,
              "maximum": 14
            }
          },
          "required": [
            "visible",
            "prefix"
          ],
          "additionalProperties": false
        },
        "takeaway": {
          "description": "Shared editable takeaway band; its text is the slide bottomLine field",
          "type": "object",
          "properties": {
            "fill": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Hex color, #RRGGBB"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Hex color, #RRGGBB"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "description": "Hex color, #RRGGBB"
            },
            "height": {
              "default": 0.65,
              "type": "number",
              "minimum": 0.35,
              "maximum": 1.5
            },
            "radius": {
              "default": 0.06,
              "type": "number",
              "minimum": 0,
              "maximum": 0.3
            }
          },
          "required": [
            "height",
            "radius"
          ],
          "additionalProperties": false
        },
        "logo": {
          "description": "PNG/JPEG logo, relative to the theme file; top-right on content slides, bottom-right on covers",
          "type": "string"
        },
        "art": {
          "description": "Background art from a brand template, drawn under everything on SlideCraft masters",
          "type": "object",
          "properties": {
            "size": {
              "type": "object",
              "properties": {
                "w": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "h": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "w",
                "h"
              ],
              "additionalProperties": false,
              "description": "Slide size the positions refer to (inches); scaled to the deck format"
            },
            "cover": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "description": "PNG/JPEG relative to the theme file"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "image",
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              }
            },
            "content": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "description": "PNG/JPEG relative to the theme file"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": [
                  "image",
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              }
            },
            "shapes": {
              "description": "Vector decoration from the template masters, drawn under the pictures",
              "type": "object",
              "properties": {
                "cover": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "rect",
                          "ellipse",
                          "line"
                        ]
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number",
                        "minimum": 0
                      },
                      "h": {
                        "type": "number",
                        "minimum": 0
                      },
                      "fill": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$",
                        "description": "Hex color, #RRGGBB"
                      },
                      "stroke": {
                        "type": "object",
                        "properties": {
                          "color": {
                            "type": "string",
                            "pattern": "^#[0-9A-Fa-f]{6}$",
                            "description": "Hex color, #RRGGBB"
                          },
                          "width": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "color",
                          "width"
                        ],
                        "additionalProperties": false
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "x",
                      "y",
                      "w",
                      "h"
                    ],
                    "additionalProperties": false
                  }
                },
                "content": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "enum": [
                          "rect",
                          "ellipse",
                          "line"
                        ]
                      },
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "w": {
                        "type": "number",
                        "minimum": 0
                      },
                      "h": {
                        "type": "number",
                        "minimum": 0
                      },
                      "fill": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$",
                        "description": "Hex color, #RRGGBB"
                      },
                      "stroke": {
                        "type": "object",
                        "properties": {
                          "color": {
                            "type": "string",
                            "pattern": "^#[0-9A-Fa-f]{6}$",
                            "description": "Hex color, #RRGGBB"
                          },
                          "width": {
                            "type": "number",
                            "minimum": 0
                          }
                        },
                        "required": [
                          "color",
                          "width"
                        ],
                        "additionalProperties": false
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "kind",
                      "x",
                      "y",
                      "w",
                      "h"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "cover",
                "content"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "size",
            "cover",
            "content"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "titleRule",
        "accentBar",
        "pageNumbers",
        "tracker"
      ],
      "additionalProperties": false
    },
    "source": {
      "description": "Where the theme came from, e.g. \"imported from brand.potx\"",
      "type": "string"
    },
    "template": {
      "description": "The brand's own .pptx/.potx, relative to the theme file: PPTX output is built inside it, on its slide masters and layouts",
      "type": "string"
    },
    "officeTheme": {
      "description": "Brand Office theme part (theme1.xml), relative to the theme file; written into PPTX output so the Design tab and colour pickers show the brand",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "bestFor",
    "mood",
    "dark",
    "prefers",
    "colors",
    "chart",
    "fonts",
    "type",
    "decor",
    "chrome"
  ],
  "additionalProperties": false
}
