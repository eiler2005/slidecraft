{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.eiler2005/slidecraft",
  "title": "SlideCraft",
  "description": "Builds editable PowerPoint, PDF and HTML decks from a deck spec, with fit, source and visual checks.",
  "version": "0.8.0",
  "websiteUrl": "https://eiler2005.github.io/slidecraft/",
  "repository": {
    "url": "https://github.com/eiler2005/slidecraft",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@eiler2005/slidecraft",
      "version": "0.8.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
