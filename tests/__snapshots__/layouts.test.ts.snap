 769.98 773.64 780.98 788.31 795.64 798.64 805.31 808.98 811.98 818.64 825.31 828.98 832.64 835.64 842.98 850.31 857.64 864.31 871.64 875.31 878.98 886.31 893.64 904.81 908.48 912.14 921.81 929.14 932.81 936.48 943.81 948.31 955.64 962.98 974.14 977.81 981.48 990.31 997.64 1004.98 1008.64 1015.98 1027.14 1034.48 1041.81 1046.31 1049.98 1057.31 1064.64 1071.98" y="612.37" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve" style="white-space:pre">Tailspin Logistics finance team, Rotterdam, September 2026</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/body"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6 70.6 82.43 87.1 91.77 102.43 114.27 118.93 130.77 136.77 148.6 160.43 172.27 176.93 187.6 193.6 198.27 208.93 219.6 225.6 232.77 244.6 255.27 267.1 278.93 289.6 294.27 298.93 310.77 322.6 328.6 334.6 346.43 353.6 359.6 370.27 376.27 388.1 399.93 411.77 422.43 428.43 440.27 450.93 461.6 473.43 485.27 497.1 503.1 513.77 519.77 531.6 542.27 548.27 560.1 571.93 583.77 595.6 601.6 613.43 624.1 635.93 643.1" y="314.11" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">Tailspin Logistics reconciled forty bank accounts by hand every</text><text x="57.6 75.43 87.27 99.1 105.1 116.93 122.93 128.93 140.77 152.6 164.43 170.43 182.27 189.43 196.6 208.43 215.6 226.27 232.27 242.93 254.77 261.93 267.93 279.77 290.43 302.27 314.1 320.1 331.93 343.77 348.43 359.1 365.1 376.93 382.93 388.93 400.77 407.93 413.93 419.93 431.77 443.6 449.6 461.43 473.27 485.1 495.77 506.43 512.43 523.1 527.77 539.6 550.27 562.1 573.93" y="339.45" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">month, and errors surfaced only after the books closed.</text><text x="57.6 71.77 77.77 83.77 95.6 102.77 108.77 119.43 131.27 143.1 154.93 166.77 177.43 183.43 188.1 199.93 211.77 217.77 222.43 228.43 239.1 245.1 256.93 268.77 280.6 291.27 301.93 307.93 313.93 325.77 331.77 347.1 358.93 370.77 376.77 388.6 399.27 411.1 417.1 423.1 429.1 440.93 452.77 458.77 464.77 469.43 481.27 493.1 504.93 515.6 527.43 533.43 539.43 551.27 563.1 580.93 586.93 594.1 605.93 616.6 621.27 633.1 648.43" y="378.11" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">After connecting its banks to Contoso, the finance team reviews</text><text x="57.6 69.43 80.1 90.77 102.6 114.43 120.43 125.1 136.93 148.77 159.43 165.43 170.1 181.93 192.6 198.6 210.43 222.27 234.1 240.1 251.93 257.93 263.93 271.1 282.93 290.1 300.77 312.6 323.27 327.93 339.77 351.6 357.6 369.43 381.27 387.27 399.1" y="403.45" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">exceptions instead of re-keying data.</text><text x="57.6 70.6 82.43 94.27 100.27 110.93 115.6 127.43 138.1 149.93 155.93 167.77 179.6 194.93 200.93 212.77 224.6 236.43 247.1 253.1 264.93 276.77 282.77 294.6 301.77 313.6 319.6 331.43 343.27 355.1 366.93 372.93 384.77 396.6 402.6 408.6 420.43 432.27 438.27 444.27 448.93 456.1 466.77 472.77 478.77 494.1 505.93 513.1 523.77 528.43 540.27 552.1 558.1 569.93 581.77 592.43 598.43 604.43 616.27 628.1" y="442.11" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">The close now ends before noon on the first working day, and</text><text x="57.6 69.43 81.27 93.1 97.77 103.77 115.6 122.77 133.43 139.43 146.6 158.43 169.1 180.93 185.6 196.27 208.1 214.1 220.1 231.93 243.77 249.77 260.43 272.27 290.1 301.93 307.93 313.93 318.6 323.27 335.1 345.77 351.77 367.1 371.77 377.77 389.6 401.43 413.27 419.27 425.27 437.1 447.77 453.77 460.93 472.77 478.77 485.93 497.77 509.6 521.43 533.27 543.93 549.93 560.6" y="468.78" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">auditors receive the same files without extra requests.</text></g></g></svg>"`;

