g font-kerning="none" font-variant-ligatures="none"><text x="81.6" y="367.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Clients go live in 6 weeks</text><text x="81.6" y="390.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">against an industry norm</text><text x="81.6" y="412.55" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">of 5 months.</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/1/body"><g font-kerning="none" font-variant-ligatures="none"><text x="379.99" y="367.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">One platform serves</text><text x="379.99" y="390.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">finance, supply chain and</text><text x="379.99" y="412.55" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">HR without separate</text><text x="379.99" y="434.95" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">contracts.</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/2/body"><g font-kerning="none" font-variant-ligatures="none"><text x="678.38" y="367.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Three-year cost of</text><text x="678.38" y="390.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">ownership is a quarter</text><text x="678.38" y="412.55" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">below the closest</text><text x="678.38" y="434.95" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">competitor.</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/3/body"><g font-kerning="none" font-variant-ligatures="none"><text x="976.78" y="367.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Local-language support is</text><text x="976.78" y="390.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">available around the clock</text><text x="976.78" y="412.55" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">for every paying client.</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source market-scan</text></g></g></svg>"`;

exports[`layout key-points > example 2 (list) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="accent-bar"><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Fabrikam can cut onboarding cost by acting on three levers</text></g></g><line x1="57.6" y1="176.64" x2="1222.37" y2="176.64" stroke="#0B1F3A" stroke-width="1.33"/><g data-sc-role="heading" data-sc-pointer="/slides/0/points/0/heading"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="217.3" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Automate document checks</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/0/body"><g font-kerning="none" font-variant-ligatures="none"><text x="490.23" y="215.43" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Machine review replaces manual checking for 80% of</text><text x="490.23" y="237.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">applications and frees the compliance team for exceptions.</text></g></g><g data-sc-role="metric" data-sc-pointer="/slides/0/points/0/metric"><g font-kerning="none" font-variant-ligatures="none"><text x="1122.76" y="228.13" font-family="Liberation Sans" font-size="42.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">-35%</text></g></g><line x1="57.6" y1="320.64" x2="1222.37" y2="320.64" stroke="#C9D2DE" stroke-width="1"/><g data-sc-role="heading" data-sc-pointer="/slides/0/points/1/heading"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="361.3" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Consolidate vendors</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/1/body"><g font-kerning="none" font-variant-ligatures="none"><text x="490.23" y="359.43" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Moving from seven identity providers to two simplifies</text><text x="490.23" y="381.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">contracts and reduces licence spend.</text></g></g><g data-sc-role="metric" data-sc-pointer="/slides/0/points/1/metric"><g font-kerning="none" font-variant-ligatures="none"><text x="1089.58" y="372.13" font-family="Liberation Sans" font-size="42.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">-€1.2M</text></g></g><line x1="57.6" y1="464.64" x2="1222.37" y2="464.64" stroke="#C9D2DE" stroke-width="1"/><g data-sc-role="heading" data-sc-pointer="/slides/0/points/2/heading"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="505.3" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Standardise the journey</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/2/body"><g font-kerning="none" font-variant-ligatures="none"><text x="490.23" y="503.43" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">One onboarding flow across all markets removes local rework</text><text x="490.23" y="525.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">and shortens training for new staff.</text></g></g><g data-sc-role="metric" data-sc-pointer="/slides/0/points/2/metric"><g font-kerning="none" font-variant-ligatures="none"><text x="1075.33" y="516.13" font-family="Liberation Sans" font-size="42.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">-9 days</text></g></g><line x1="57.6" y1="608.64" x2="1222.37" y2="608.64" stroke="#C9D2DE" stroke-width="1"/><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source fabrikam-ops</text></g></g></svg>"`;

