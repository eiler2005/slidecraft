exports[`layout text > example 2 (paragraphs) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><g data-sc-role="page-number"><g font-kerning="none" font-variant-ligatures="none"><text x="1216.03" y="680.75" font-family="Liberation Sans" font-size="12" fill="#5B6B7F" xml:space="preserve" style="white-space:pre">1</text></g></g><g data-sc-role="accent-bar"><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6 77.1 96.6 114.43 123.27 142.77 151.6 160.43 179.93 190.6 199.43 208.27 226.1 234.93 254.43 272.27 290.1 298.93 318.43 337.93 355.77 375.27 384.1 394.77 414.27 423.1 440.93 460.43 478.27 503.1 520.93 533.43 542.27 561.77 581.27 599.1 607.93 627.43 646.93 664.77 682.6 693.27 702.1 721.6 741.1 749.93 769.43 787.27 797.93 817.43 829.93 847.77 856.6 874.43 893.93 911.77 920.6 929.43 947.27 959.77 979.27 997.1 1009.6 1018.43 1036.27 1055.77 1084.27 1112.77 1121.6 1132.27 1160.77 1178.6 1198.1" y="95.2" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">The pilot is designed to answer one question before any larger commitment</text></g></g><g data-sc-pointer="/slides/0/items"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6 72.93 84.77 96.6 102.6 114.43 126.27 133.43 139.43 151.27 163.1 170.27 180.93 186.93 198.77 205.93 210.6 222.43 234.27 240.27 252.1 262.77 268.77 274.77 279.43 285.43 291.43 303.27 315.1 326.93 332.93 344.77 356.6 367.27 371.93 383.77 395.6 401.6 419.43 424.1 435.93 443.1 460.93 472.77 479.93 490.6 502.43 508.43 514.43 525.1 529.77 534.43 546.27 558.1 564.1 574.77 580.77 585.43 597.27 603.27 609.27 624.6 636.43 642.43 654.27 666.1 677.93 685.1 691.1 702.93 710.1 720.77 726.77 738.6 744.6 750.6 762.43 774.27 780.27 792.1 802.77 814.6 826.43 831.1 841.77 846.43 852.43 857.1 868.93 880.77 886.77 897.43 909.27 919.93 925.93 931.93 947.27 959.1 965.1 975.77 987.6" y="197.97" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">Can partners bring us fifteen paying mid-market clients in two quarters at an acquisition cost we can</text><text x="57.6 68.27 80.1 90.77 96.77 108.6 113.27 125.1" y="223.31" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">sustain?</text><text x="57.6 63.6 69.6 75.6 86.27 98.1 108.77 114.77 120.77 132.6 144.43 156.27 166.93 178.77 184.77 196.6 202.6 214.43 226.27 238.1 248.77 254.77 266.6 278.43 285.6 291.6 303.43 315.27 322.43 333.1 339.1 350.93 362.77 374.6 380.6 387.77 399.6 411.43 416.1 427.93 439.77 450.43 456.43 462.43 467.1 473.1 479.1 490.93 502.77 508.77 514.77 520.77 536.1 547.93 553.93 564.6 570.6 582.43 594.27 600.27 615.6 620.27 626.27 638.1 644.1 655.93 667.77 685.6 691.6 702.27 714.1 725.93 737.77 743.77 749.77 761.6 773.43 785.27 791.27 803.1 809.1 819.77 824.43 836.27 848.1 855.27 861.27 865.93 877.77 888.43 899.1 910.93 922.77 928.77 940.6 952.43 964.27 976.1 982.1 988.1 994.1 1005.93" y="267.31" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">If yes, phase 2 adds partners and regions; if not, we stop with €6M spent and a clear lesson about the</text><text x="57.6 75.43 87.27 94.43 105.1 116.93 122.93" y="292.64" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve" style="white-space:pre">market.</text></g></g></svg>"`;

