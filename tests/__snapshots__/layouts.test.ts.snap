ml:space="preserve">and 8% under budget.</text></svg>"`;

exports[`layout team-cards > example 1 (compact) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Six accountable owners cover every workstream of the launch</text><rect x="57.6" y="186.24" width="48" height="4.32" fill="#1F5FBF" stroke="none"/><text x="57.6" y="224.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Anna Keller</text><text x="57.6" y="245.9" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Sponsor, Managing Director DACH</text><text x="57.6" y="275.95" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">Owns the P&amp;L and the board relationship.</text><rect x="455.46" y="186.24" width="48" height="4.32" fill="#1F5FBF" stroke="none"/><text x="455.46" y="224.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Marcus Lindgren</text><text x="455.46" y="245.9" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Partnerships lead</text><text x="455.46" y="275.95" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">Shortlist, negotiation and onboarding of the first ten</text><text x="455.46" y="295.15" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">partners.</text><rect x="853.31" y="186.24" width="48" height="4.32" fill="#1F5FBF" stroke="none"/><text x="853.31" y="224.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Priya Nair</text><text x="853.31" y="245.9" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Finance lead</text><text x="853.31" y="275.95" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">Phase gates, budget control and the entity set-up.</text><rect x="57.6" y="433.44" width="48" height="4.32" fill="#1F5FBF" stroke="none"/><text x="57.6" y="471.57" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Tomas Weber</text><text x="57.6" y="493.1" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Program director</text><text x="57.6" y="523.15" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">Integrated plan, risks and weekly steering reports.</text><rect x="455.46" y="433.44" width="48" height="4.32" fill="#1F5FBF" stroke="none"/><text x="455.46" y="471.57" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Elena Rossi</text><text x="455.46" y="493.1" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Product and localization lead</text><text x="455.46" y="523.15" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">German-language product, data residency and</text><text x="455.46" y="542.35" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">compliance.</text><rect x="853.31" y="433.44" width="48" height="4.32" fill="#1F5FBF" stroke="none"/><text x="853.31" y="471.57" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Jonas Becker</text><text x="853.31" y="493.1" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Sales enablement lead</text><text x="853.31" y="523.15" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">Playbooks, training and the reference-client</text><text x="853.31" y="542.35" font-family="Liberation Sans" font-size="16" fill="#5B6B7F" xml:space="preserve">program.</text></svg>"`;

exports[`layout text > example 0 (bullets) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Three principles keep the pilot small, measurable and reversible</text><text x="57.6" y="194.31" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="76.27" y="194.31" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Scope is two regions and fifteen clients; anything else waits for Gate 1</text><text x="57.6" y="230.04" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="76.27" y="230.04" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Every week reports the same four metrics against the same baseline</text><text x="57.6" y="265.78" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="76.27" y="265.78" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Exit clauses with both partners let us stop within one quarter</text></svg>"`;

exports[`layout text > example 1 (two-column) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Scope is explicit: what the pilot covers and what it does not</text><rect x="57.6" y="176.64" width="48" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="209.97" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">In scope</text><text x="57.6" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="76.27" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Mid-market clients in Bavaria and Hesse</text><text x="57.6" y="294.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="76.27" y="294.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Partner-led sales and onboarding</text><text x="57.6" y="327.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="76.27" y="327.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">German UI and Frankfurt hosting</text><rect x="668.78" y="176.64" width="48" height="4.8" fill="#1F5FBF" stroke="none"/><text x="668.78" y="209.97" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Out of scope</text><text x="668.78" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="687.45" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Enterprise accounts</text><text x="668.78" y="294.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="687.45" y="294.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Direct sales hires</text><text x="668.78" y="327.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="687.45" y="327.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Custom integrations</text></svg>"`;

exports[`layout text > example 2 (paragraphs) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">The pilot is designed to answer one question before any larger commitment</text><text x="57.6" y="196.84" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">Can partners bring us fifteen paying mid-market clients in two quarters at an acquisition cost we can</text><text x="57.6" y="222.44" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">sustain?</text><text x="57.6" y="266.7" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">If yes, phase 2 adds partners and regions; if not, we stop with €6M spent and a clear lesson about the</text><text x="57.6" y="292.3" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">market.</text></svg>"`;

exports[`layout text-image > example 0 (image-right) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Contoso turned a two-day month-end close into a morning routine</text><rect x="724.14" y="176.64" width="498.23" height="412.8" fill="#E9ECF0" stroke="#AEB6C1" stroke-width="1" stroke-dasharray="6 4"/><line x1="724.14" y1="176.64" x2="1222.37" y2="589.44" stroke="#C5CBD3" stroke-width="1"/><line x1="1222.37" y1="176.64" x2="724.14" y2="589.44" stroke="#C5CBD3" stroke-width="1"/><text x="973.26" y="388.04" text-anchor="middle" font-family="Liberation Sans" font-size="14" fill="#6B7480">Image placeholder</text><text x="724.14" y="611.66" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Tailspin Logistics finance team, Rotterdam, September 2026</text><text x="57.6" y="313.1" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">Tailspin Logistics reconciled forty bank accounts by hand every</text><text x="57.6" y="338.7" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">month, and errors surfaced only after the books closed.</text><text x="57.6" y="377.64" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">After connecting its banks to Contoso, the finance team reviews</text><text x="57.6" y="403.24" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">exceptions instead of re-keying data.</text><text x="57.6" y="442.17" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">The close now ends before noon on the first working day, and</text><text x="57.6" y="467.77" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">auditors receive the same files without extra requests.</text></svg>"`;

exports[`layout text-image > example 1 (image-left) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Fabrikam designs every store around how people actually shop</text><rect x="57.6" y="176.64" width="498.23" height="412.8" fill="#E9ECF0" stroke="#AEB6C1" stroke-width="1" stroke-dasharray="6 4"/><line x1="57.6" y1="176.64" x2="555.83" y2="589.44" stroke="#C5CBD3" stroke-width="1"/><line x1="555.83" y1="176.64" x2="57.6" y2="589.44" stroke="#C5CBD3" stroke-width="1"/><text x="306.71" y="388.04" text-anchor="middle" font-family="Liberation Sans" font-size="14" fill="#6B7480">Image placeholder</text><text x="57.6" y="611.66" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Fabrikam flagship store, Hamburg</text><text x="613.43" y="313.1" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A">•</text><text x="632.09" y="313.1" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">Wide aisles and short sight lines keep the store calm during</text><text x="632.09" y="338.7" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">peak hours.</text><text x="613.43" y="377.64" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A">•</text><text x="632.09" y="377.64" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">Fresh products sit at the entrance, so customers see quality</text><text x="632.09" y="403.24" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">first.</text><text x="613.43" y="442.17" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A">•</text><text x="632.09" y="442.17" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">Self-service tills handle most baskets, and staff move to the</text><text x="632.09" y="467.77" font-family="Liberation Sans" font-size="21.33" fill="#0B1F3A" xml:space="preserve">shop floor to help.</text></svg>"`;

exports[`layout timeline > example 0 (milestones) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">First German revenue lands in Q3 2027, nine months after the decision</text><line x1="57.6" y1="407.04" x2="1222.37" y2="407.04" stroke="#C9D2DE" stroke-width="2.67"/><line x1="174.08" y1="378.24" x2="174.08" y2="407.04" stroke="#C9D2DE" stroke-width="1.33"/><ellipse cx="174.08" cy="407.04" rx="8.16" ry="8.16" fill="#FFFFFF" stroke="#0B1F3A" stroke-width="2"/><text x="151.01" y="301.51" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Nov 2026</text><text x="124.58" y="323.91" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Board decision</text><text x="94.97" y="346.31" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Phase-1 budget of €6M</text><text x="153.08" y="368.71" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">approved</text><line x1="407.03" y1="435.84" x2="407.03" y2="407.04" stroke="#C9D2DE" stroke-width="1.33"/><ellipse cx="407.03" cy="407.04" rx="8.16" ry="8.16" fill="#FFFFFF" stroke="#0B1F3A" stroke-width="2"/><text x="367.59" y="458.31" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Jan 2027</text><text x="336.49" y="480.71" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Partners signed</text><text x="283.08" y="503.11" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Two resellers with mid-market</text><text x="384.21" y="525.51" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">rights</text><line x1="639.98" y1="378.24" x2="639.98" y2="407.04" stroke="#C9D2DE" stroke-width="1.33"/><ellipse cx="639.98" cy="407.04" rx="8.16" ry="8.16" fill="#FFFFFF" stroke="#0B1F3A" stroke-width="2"/><text x="600.55" y="301.51" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Apr 2027</text><text x="559.6" y="323.91" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Localised product</text><text x="536.24" y="346.31" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">German UI and Frankfurt</text><text x="593.29" y="368.71" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">hosting live</text><line x1="872.94" y1="435.84" x2="872.94" y2="407.04" stroke="#1F5FBF" stroke-width="1.33"/><ellipse cx="872.94" cy="407.04" rx="12.48" ry="12.48" fill="#1F5FBF" stroke="#1F5FBF" stroke-width="2"/><text x="836.1" y="458.31" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Jul 2027</text><text x="814.32" y="480.71" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">First revenue</text><text x="784.22" y="503.11" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">15 pilot clients go live</text><line x1="1105.89" y1="378.24" x2="1105.89" y2="407.04" stroke="#C9D2DE" stroke-width="1.33"/><ellipse cx="1105.89" cy="407.04" rx="8.16" ry="8.16" fill="#FFFFFF" stroke="#0B1F3A" stroke-width="2"/><text x="1052.16" y="301.51" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Q1 2028</text><text x="1059.43" y="323.91" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Gate 2</text><text x="994.59" y="346.31" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Scale direct sales if 40</text><text x="1043.87" y="368.71" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">references</text></svg>"`;

