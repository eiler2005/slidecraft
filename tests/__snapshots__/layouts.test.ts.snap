g data-sc-role="card-accent"><rect x="804.94" y="176.64" width="8.16" height="219.36" rx="4.08" fill="#0B1F3A" stroke="none"/></g><g data-sc-pointer="/slides/0/cards/1/label"><g font-kerning="none" font-variant-ligatures="none"><text x="835.66" y="209.42" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">SPECIALIST SUPPORT</text></g></g><g data-sc-pointer="/slides/0/cards/1/title"><g font-kerning="none" font-variant-ligatures="none"><text x="835.66" y="257.62" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Complex decisions</text></g></g><g data-sc-pointer="/slides/0/cards/1/body"><g font-kerning="none" font-variant-ligatures="none"><text x="835.66" y="295.77" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">Expert teams handle ambiguity and</text><text x="835.66" y="316.57" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">exceptions.</text></g></g><g data-sc-role="comparison-card"><rect x="361.58" y="418.08" width="417.43" height="219.36" rx="8.64" fill="#F2F5F9" stroke="#C9D2DE" stroke-width="0.8"/></g><g data-sc-role="card-accent"><rect x="361.58" y="418.08" width="8.16" height="219.36" rx="4.08" fill="#7F9CC4" stroke="none"/></g><g data-sc-pointer="/slides/0/cards/2/label"><g font-kerning="none" font-variant-ligatures="none"><text x="392.3" y="450.86" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">SHARED PLATFORM</text></g></g><g data-sc-pointer="/slides/0/cards/2/title"><g font-kerning="none" font-variant-ligatures="none"><text x="392.3" y="499.06" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Common capabilities</text></g></g><g data-sc-pointer="/slides/0/cards/2/body"><g font-kerning="none" font-variant-ligatures="none"><text x="392.3" y="537.21" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">Reusable infrastructure supports several</text><text x="392.3" y="558.01" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">service lines.</text></g></g><g data-sc-role="comparison-card"><rect x="804.94" y="418.08" width="417.43" height="219.36" rx="8.64" fill="#F2F5F9" stroke="#C9D2DE" stroke-width="0.8"/></g><g data-sc-role="card-accent"><rect x="804.94" y="418.08" width="8.16" height="219.36" rx="4.08" fill="#B9C7DA" stroke="none"/></g><g data-sc-pointer="/slides/0/cards/3/label"><g font-kerning="none" font-variant-ligatures="none"><text x="835.66" y="450.86" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">PARTNERSHIPS</text></g></g><g data-sc-pointer="/slides/0/cards/3/title"><g font-kerning="none" font-variant-ligatures="none"><text x="835.66" y="499.06" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">External capabilities</text></g></g><g data-sc-pointer="/slides/0/cards/3/body"><g font-kerning="none" font-variant-ligatures="none"><text x="835.66" y="537.21" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">Partners provide skills that are needed</text><text x="835.66" y="558.01" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">selectively.</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source illustrative-survey</text></g></g></svg>"`;

exports[`layout exec-summary > example 0 (scr) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="accent-bar"><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Entering Germany now captures a €40M window before two rivals scale</text></g></g><g data-sc-role="ask-band"><rect x="57.6" y="566.52" width="1164.77" height="70.92" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="ask" data-sc-pointer="/slides/0/ask"><g font-kerning="none" font-variant-ligatures="none"><text x="81.6" y="608.45" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Decision requested:</text><text x="260.02" y="608.45" font-family="Liberation Sans" font-size="18.67" fill="#FFFFFF" xml:space="preserve"> Approve a €6M phase-1 budget and the partner shortlist at this meeting</text></g></g><g data-sc-role="label"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="204.62" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">SITUATION</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/situation"><g font-kerning="none" font-variant-ligatures="none"><text x="275.73" y="205.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Our UK mid-market business grew 18% a year since 2022 and now funds itself; the product is proven in a</text><text x="275.73" y="228.23" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">regulated market.</text></g></g><line x1="57.6" y1="293.71" x2="1222.37" y2="293.71" stroke="#C9D2DE" stroke-width="1"/><g data-sc-role="label"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="321.69" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">COMPLICATION</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/complication"><g font-kerning="none" font-variant-ligatures="none"><text x="275.73" y="322.9" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Two well-funded competitors are preparing German launches in 2027, and switching costs make early share</text><text x="275.73" y="345.3" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">sticky.</text></g></g><line x1="57.6" y1="410.78" x2="1222.37" y2="410.78" stroke="#C9D2DE" stroke-width="1"/><g data-sc-role="label"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="438.76" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">RESOLUTION</text></g></g><g data-sc-role="answer" data-sc-pointer="/slides/0/resolution"><g font-kerning="none" font-variant-ligatures="none"><text x="275.73" y="441.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Enter Germany in 2027 through a partner-led model, scaling direct sales only after 40 reference</text><text x="275.73" y="465.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">clients.</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source board-pack</text></g></g></svg>"`;

exports[`layout exec-summary > example 1 (key-messages) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="accent-bar"><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Three facts make the case for a partner-led entry</text></g></g><g data-sc-role="number"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="220.37" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">1</text></g></g><g data-sc-role="headline" data-sc-pointer="/slides/0/messages/0/headline"><g font-kerning="none" font-variant-ligatures="none"><text x="124.8" y="207.09" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">The German mid-market is 3× our UK base and</text><text x="124.8" y="231.09" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">under-served</text></g></g><g data-sc-role="detail" data-sc-pointer="/slides/0/messages/0/detail"><g font-kerning="none" font-variant-ligatures="none"><text x="655.84" y="205.83" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">41,000 firms in our segment; the top vendor holds under 12% share.</text></g></g><line x1="57.6" y1="330.24" x2="1222.37" y2="330.24" stroke="#C9D2DE" stroke-width="1"/><g data-sc-role="number"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="373.97" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">2</text></g></g><g data-sc-role="headline" data-sc-pointer="/slides/0/messages/1/headline"><g font-kerning="none" font-variant-ligatures="none"><text x="124.8" y="360.69" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Partners cut time-to-first-revenue from 18 to 7</text><text x="124.8" y="384.69" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">months</text></g></g><g data-sc-role="detail" data-sc-pointer="/slides/0/messages/1/detail"><g font-kerning="none" font-variant-ligatures="none"><text x="655.84" y="359.43" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Benchmarks from four comparable SaaS entries, 2019–2025.</text></g></g><line x1="57.6" y1="483.84" x2="1222.37" y2="483.84" stroke="#C9D2DE" stroke-width="1"/><g data-sc-role="number"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="527.57" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">3</text></g></g><g data-sc-role="headline" data-sc-pointer="/slides/0/messages/2/headline"><g font-kerning="none" font-variant-ligatures="none"><text x="124.8" y="514.29" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Phase 1 is self-limiting: €6M at risk, exit gates every</text><text x="124.8" y="538.29" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">quarter</text></g></g><g data-sc-role="detail" data-sc-pointer="/slides/0/messages/2/detail"><g font-kerning="none" font-variant-ligatures="none"><text x="655.84" y="513.03" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Stop if fewer than 15 signed clients by Q4 2027.</text></g></g></svg>"`;

exports[`layout five-forces > example 0 (diagram) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="accent-bar"><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">German regional freight is attractive: buyers are fragmented and entry is</text><text x="57.6" y="132.05" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">hard</text></g></g><line x1="639.98" y1="313.6" x2="639.98" y2="336.64" stroke="#5B6B7F" stroke-width="2"/><polygon points="639.98,336.64 635.63,328.09 644.34,328.09" fill="#5B6B7F"/><line x1="639.98" y1="500.48" x2="639.98" y2="477.44" stroke="#5B6B7F" stroke-width="2"/><polygon points="639.98,477.44 644.34,485.99 635.63,485.99" fill="#5B6B7F"/><line x1="417.7" y1="407.04" x2="458.02" y2="407.04" stroke="#5B6B7F" stroke-width="2"/><polygon points="458.02,407.04 449.46,411.4 449.46,402.68" fill="#5B6B7F"/><line x1="862.27" y1="407.04" x2="821.95" y2="407.04" stroke="#5B6B7F" stroke-width="2"/><polygon points="821.95,407.04 830.51,402.68 830.51,411.4" fill="#5B6B7F"/><g data-sc-role="panel"><rect x="461.86" y="176.64" width="356.26" height="133.12" fill="#F2F5F9" stroke="none"/></g><g font-kerning="none" font-variant-ligatures="none"><text x="482.98" y="202.7" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">NEW ENTRANTS</text></g><g data-sc-role="rating"><rect x="720.19" y="189.12" width=