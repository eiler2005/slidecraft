00</text><line x1="551.15" y1="347.52" x2="788.05" y2="347.52" stroke="#C9D2DE" stroke-width="0.67"/><text x="761.09" y="334.96" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">82</text><line x1="788.05" y1="347.52" x2="1024.95" y2="347.52" stroke="#C9D2DE" stroke-width="0.67"/><text x="982.58" y="334.96" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">31%</text><line x1="1024.95" y1="347.52" x2="1222.37" y2="347.52" stroke="#C9D2DE" stroke-width="0.67"/><text x="1190.59" y="334.96" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">4.4</text><text x="57.6" y="374.54" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Target firms: companies with 250–5,000 employees in regulated industries. Entry cost covers three years.</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source market-study</text></svg>"`;

exports[`layout data-table > example 1 (with-takeaway) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Enterprise wins on margin and retention, while SMB lags on every measure</text><line x1="57.6" y1="209.28" x2="288.28" y2="209.28" stroke="#0B1F3A" stroke-width="1.33"/><text x="65.28" y="197.39" font-family="Liberation Sans" font-size="16" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Segment</text><line x1="288.28" y1="209.28" x2="465.73" y2="209.28" stroke="#0B1F3A" stroke-width="1.33"/><text x="360.24" y="197.39" font-family="Liberation Sans" font-size="16" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Revenue, €M</text><line x1="465.73" y1="209.28" x2="643.18" y2="209.28" stroke="#0B1F3A" stroke-width="1.33"/><text x="583.05" y="197.39" font-family="Liberation Sans" font-size="16" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Margin</text><line x1="643.18" y1="209.28" x2="820.62" y2="209.28" stroke="#0B1F3A" stroke-width="1.33"/><text x="714.27" y="197.39" font-family="Liberation Sans" font-size="16" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Net retention</text><rect x="57.6" y="209.28" width="230.68" height="34.56" fill="#E3ECF9"/><line x1="57.6" y1="243.84" x2="288.28" y2="243.84" stroke="#C9D2DE" stroke-width="0.67"/><text x="65.28" y="231.28" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Enterprise</text><rect x="288.28" y="209.28" width="177.45" height="34.56" fill="#E3ECF9"/><line x1="288.28" y1="243.84" x2="465.73" y2="243.84" stroke="#C9D2DE" stroke-width="0.67"/><text x="424.31" y="231.28" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">19.4</text><rect x="465.73" y="209.28" width="177.45" height="34.56" fill="#E3ECF9"/><line x1="465.73" y1="243.84" x2="643.18" y2="243.84" stroke="#C9D2DE" stroke-width="0.67"/><text x="600.8" y="231.28" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">31%</text><rect x="643.18" y="209.28" width="177.45" height="34.56" fill="#E3ECF9"/><line x1="643.18" y1="243.84" x2="820.62" y2="243.84" stroke="#C9D2DE" stroke-width="0.67"/><text x="768.61" y="231.28" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">118%</text><line x1="57.6" y1="278.4" x2="288.28" y2="278.4" stroke="#C9D2DE" stroke-width="0.67"/><text x="65.28" y="265.84" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Mid-market</text><line x1="288.28" y1="278.4" x2="465.73" y2="278.4" stroke="#C9D2DE" stroke-width="0.67"/><text x="424.31" y="265.84" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">14.6</text><line x1="465.73" y1="278.4" x2="643.18" y2="278.4" stroke="#C9D2DE" stroke-width="0.67"/><text x="600.8" y="265.84" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">27%</text><line x1="643.18" y1="278.4" x2="820.62" y2="278.4" stroke="#C9D2DE" stroke-width="0.67"/><text x="768.61" y="265.84" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">112%</text><line x1="57.6" y1="312.96" x2="288.28" y2="312.96" stroke="#C9D2DE" stroke-width="0.67"/><text x="65.28" y="300.4" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">SMB</text><line x1="288.28" y1="312.96" x2="465.73" y2="312.96" stroke="#C9D2DE" stroke-width="0.67"/><text x="433.95" y="300.4" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">8.0</text><line x1="465.73" y1="312.96" x2="643.18" y2="312.96" stroke="#C9D2DE" stroke-width="0.67"/><text x="600.8" y="300.4" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">11%</text><line x1="643.18" y1="312.96" x2="820.62" y2="312.96" stroke="#C9D2DE" stroke-width="0.67"/><text x="778.25" y="300.4" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">94%</text><text x="57.6" y="339.98" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Margin is contribution margin after support and success costs.</text><rect x="859.02" y="176.64" width="363.34" height="460.8" fill="#F2F5F9" stroke="none"/><rect x="859.02" y="176.64" width="5.76" height="460.8" fill="#1F5FBF" stroke="none"/><text x="887.82" y="224.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">SMB grows revenue but</text><text x="887.82" y="248.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">destroys value</text><text x="887.82" y="295.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="906.49" y="295.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Support cost per SMB account is</text><text x="906.49" y="317.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">3× the enterprise level</text><text x="887.82" y="350.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="906.49" y="350.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Net retention below 100% means</text><text x="906.49" y="372.98" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">growth depends on new logos</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source finance-fy25</text></svg>"`;

exports[`layout exec-summary > example 0 (scr) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Entering Germany now captures a €40M window before two rivals scale</text><rect x="57.6" y="566.52" width="1164.77" height="70.92" fill="#1F5FBF" stroke="none"/><text x="81.6" y="608.45" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Decision requested:</text><text x="260.02" y="608.45" font-family="Liberation Sans" font-size="18.67" fill="#FFFFFF" xml:space="preserve"> Approve a €6M phase-1 budget and the partner shortlist at this meeting</text><text x="57.6" y="204.62" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">SITUATION</text><text x="275.73" y="205.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Our UK mid-market business grew 18% a year since 2022 and now funds itself; the product is proven in a</text><text x="275.73" y="228.23" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">regulated market.</text><line x1="57.6" y1="293.71" x2="1222.37" y2="293.71" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="321.69" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">COMPLICATION</text><text x="275.73" y="322.9" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Two well-funded competitors are preparing German launches in 2027, and switching costs make early share</text><text x="275.73" y="345.3" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">sticky.</text><line x1="57.6" y1="410.78" x2="1222.37" y2="410.78" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="438.76" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">RESOLUTION</text><text x="275.73" y="441.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Enter Germany in 2027 through a partner-led model, scaling direct sales only after 40 reference</text><text x="275.73" y="465.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">clients.</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source board-pack</text></svg>"`;

exports[`layout exec-summary > example 1 (key-messages) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Three facts make the case for a partner-led entry</text><text x="57.6" y="220.37" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">1</text><text x="124.8" y="207.09" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">The German mid-market is 3× our UK base and</text><text x="124.8" y="231.09" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">under-served</text><text x="655.84" y="205.83" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">41,000 firms in our segment; the top vendor holds under 12% share.</text><line x1="57.6" y1="330.24" x2="1222.37" y2="330.24" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="373.97" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">2</text><text x="124.8" y="360.69" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Partners cut time-to-first-revenue from 18 to 7</text><text x="124.8" y="384.69" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">months</text><text x="655.84" y="359.43" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Benchmarks from four comparable SaaS entries, 2019–2025.</text><line x1="57.6" y1="483.84" x2="1222.37" y2="483.84" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="527.57" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">3</text><text x="124.8" y="514.29" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Phase 1 is self-limiting: €6M at risk, exit gates every</text><text x="124.8" y="538.29" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">quarter</text><text x="655.84" y="513.03" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Stop if fewer than 15 signed clients by Q4 2027.</text></svg>"`;

exports[`layout funnel > example 0 (funnel) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Most trials are lost before activation — fixing onboarding is worth more than</text><text x="57.6" y="132.05" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">more traffic</text><polygon points="57.6,176.64 518.75,176.64 483.01,286.08 93.34,286.08" fill="#84A7DC" stroke="none"/><text x="253.51" y="239.22" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#FFFFFF" xml:space="preserve">48,000</text><line x1="523.55" y1="231.36" x2="544.67" y2="231.36" stroke="#C9D2DE" stroke-width="1"/><text x="552.35" y="237.37" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Website visitors</text><text x="811.92" y="287.18" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">↓ 6.5%</text><polygon points="93.34,293.76 483.01,293.76 447.27,403.2 129.08,403.2" fill="#A2BCE4" stroke="none"/><text x="259.81" y="356.34" font-family="Liberation Sans" font-size="22.67" font-weight="bold" fill="#FFFFFF" xml:space="preserve">3,100</text><line x1="487.81" y1="348.48" x2="544.67" y2="348.48" stroke="#C9D2DE" stroke-width="1"/><text x="552.35" y="354.49" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Trial sign-ups</text><text x="815.63" y="404.3" font-family="Liberation Sans" font-size="13.33" font-weight="bold" 