exports[`layout options-comparison > example 0 (text) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">A partner-led entry beats direct build and acquisition on speed and risk</text><rect x="57.6" y="582.4" width="1164.77" height="55.04" fill="#F2F5F9" stroke="none"/><rect x="57.6" y="582.4" width="5.76" height="55.04" fill="#1F5FBF" stroke="none"/><text x="81.6" y="616.39" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Verdict:</text><text x="151.1" y="616.39" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve"> Partner-led keeps €6M at risk with quarterly exit gates and still reaches revenue in 2027</text><rect x="690.68" y="176.64" width="260.08" height="388.48" fill="#E3ECF9" stroke="none"/><text x="497.96" y="203.25" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Direct build</text><text x="464.4" y="225.74" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Own sales team from day one</text><text x="775.08" y="195.05" font-family="Liberation Sans" font-size="11.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">RECOMMENDED</text><text x="767.93" y="224.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Partner-led</text><text x="746.26" y="246.86" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Two resellers, direct later</text><text x="1051.26" y="203.25" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Acquire</text><text x="1035.87" y="225.74" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Buy a local player</text><line x1="57.6" y1="258.24" x2="1222.37" y2="258.24" stroke="#0B1F3A" stroke-width="1.33"/><text x="57.6" y="303.07" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Time to first revenue</text><text x="512.49" y="302.61" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">18 months</text><text x="782.2" y="302.61" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">7 months</text><text x="1052.84" y="302.61" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">4 months</text><line x1="57.6" y1="334.96" x2="1222.37" y2="334.96" stroke="#C9D2DE" stroke-width="0.67"/><text x="57.6" y="379.79" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Capital at risk</text><text x="531.28" y="379.33" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">€14M</text><text x="803.86" y="379.33" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">€6M</text><text x="1052.35" y="379.33" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">€35–45M</text><line x1="57.6" y1="411.68" x2="1222.37" y2="411.68" stroke="#C9D2DE" stroke-width="0.67"/><text x="57.6" y="456.51" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Control of customer</text><text x="539" y="456.05" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">Full</text><text x="739.3" y="456.05" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Shared in years 1–2</text><text x="1074.52" y="456.05" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">Full</text><line x1="57.6" y1="488.4" x2="1222.37" y2="488.4" stroke="#C9D2DE" stroke-width="0.67"/><text x="57.6" y="533.24" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Reversibility</text><text x="486.97" y="532.77" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">Low — sunk cost</text><text x="748.01" y="532.77" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">High — exit gates</text><text x="1055.25" y="532.77" font-family="Liberation Sans" font-size="17.33" fill="#23364F" xml:space="preserve">Very low</text><line x1="57.6" y1="565.12" x2="1222.37" y2="565.12" stroke="#C9D2DE" stroke-width="0.67"/><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source strategy-analysis</text></svg>"`;

