exports[`layout next-steps > example 1 (decision) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">We ask for approval today so the first partner contracts close by year-end</text><rect x="57.6" y="176.64" width="424.37" height="460.8" fill="#1F5FBF" stroke="none"/><text x="96" y="227.66" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">DECISION REQUESTED</text><line x1="96" y1="255.36" x2="144" y2="255.36" stroke="#FFFFFF" stroke-width="2"/><text x="96" y="309.72" font-family="Liberation Sans" font-size="29.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Approve a €6M phase-1</text><text x="96" y="344.33" font-family="Liberation Sans" font-size="29.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">budget and the partner</text><text x="96" y="378.94" font-family="Liberation Sans" font-size="29.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">shortlist</text><line x1="529.97" y1="176.64" x2="1222.37" y2="176.64" stroke="#0B1F3A" stroke-width="1.33"/><text x="529.97" y="235.73" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">1</text><text x="592.37" y="217.67" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Release the first budget tranche and appoint the program director</text><text x="592.37" y="238.86" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">P. Nair · 14 Nov</text><line x1="52