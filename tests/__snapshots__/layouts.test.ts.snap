family="Liberation Sans" font-size="13.33" font-style="italic" fill="#5B6B7F" xml:space="preserve">Counsel memo, Oct 2026</text></g></g><g data-sc-role="conclusion"><rect x="57.6" y="517.44" width="1164.77" height="76.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-pointer="/slides/0/conclusion"><g font-kerning="none" font-variant-ligatures="none"><text x="86.4" y="562.31" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Therefore: </text><text x="183.9" y="562.31" font-family="Liberation Sans" font-size="18.67" fill="#FFFFFF" xml:space="preserve">Release in all regions on 1 December, with the two EU markets following the legal opinion</text></g></g><g data-sc-pointer="/slides/0/exception"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="614.54" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Unless: </text><text x="109.47" y="614.54" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">A negative legal opinion would hold those two markets on current prices</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source pricing-pilot</text></g></g></svg>"`;

exports[`layout evidence-panorama > example 0 (metric-and-cards) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="accent-bar"><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Strong adoption supports four distinct service models, not one universal</text><text x="57.6" y="132.05" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">offer</text></g></g><g data-sc-role="stat-panel"><rect x="57.6" y="176.64" width="273.26" height="460.8" rx="8.64" fill="#0B1F3A" stroke="none"/></g><g data-sc-pointer="/slides/0/metric/value"><g font-kerning="none" font-variant-ligatures="none"><text x="130.19" y="261.23" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#FFFFFF" xml:space="preserve">72%</text></g></g><g data-sc-pointer="/slides/0/metric/label"><g font-kerning="none" font-variant-ligatures="none"><text x="106.41" y="318.45" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#7F9CC4" xml:space="preserve">of surveyed teams</text></g></g><g data-sc-pointer="/slides/0/metric/context"><g font-kerning="none" font-variant-ligatures="none"><text x="97.2" y="393.99" font-family="Liberation Sans" font-size="18.67" fill="#FFFFFF" xml:space="preserve">use at least one shared</text><text x="164.67" y="416.39" font-family="Liberation Sans" font-size="18.67" fill="#FFFFFF" xml:space="preserve">service</text></g></g><line x1="80.64" y1="