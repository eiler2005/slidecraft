exports[`layout agenda > example 0 (agenda) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><svg xmlns="http://www.w3.org/2000/svg" x="0" y="0" width="1279.97" height="720" preserveAspectRatio="none" viewBox="0 0 2133 1200"><defs></defs><rect x="0" y="0" width="2133" height="9.6" fill="#1F5FBF"/></svg><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="86.4" y="59.52" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="86.4" y="117.19" font-family="Liberation Sans" font-size="42.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Agenda</text><line x1="86.4" y1="187.2" x2="1193.57" y2="187.2" stroke="#0B1F3A" stroke-width="1.33"/><text x="110.4" y="242.38" font-family="Liberation Sans" font-size="37.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">01</text><text x="216" y="224.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Market opportunity</text><text x="216" y="250.95" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Why the German mid-market is large, under-served and open until 2027</text><line x1="86.4" y1="271.68" x2="1193.57" y2="271.68" stroke="#C9D2DE" stroke-width="0.67"/><text x="110.4" y="326.86" font-family="Liberation Sans" font-size="37.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">02</text><text x="216" y="308.85" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Entry options</text><text x="216" y="335.43" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Direct, partner-led and acquisition routes compared on risk and speed</text><line x1="86.4" y1="356.16" x2="1193.57" y2="356.16" stroke="#C9D2DE" stroke-width="0.67"/><text x="110.4" y="411.34" font-family="Liberation Sans" font-size="37.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">03</text><text x="216" y="393.33" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Recommended plan</text><text x="216" y="419.91" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">A partner-led launch with quarterly exit gates</text><line x1="86.4" y1="440.64" x2="1193.57" y2="440.64" stroke="#C9D2DE" stroke-width="0.67"/><text x="110.4" y="495.82" font-family="Liberation Sans" font-size="37.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">04</text><text x="216" y="477.81" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Financials and risks</text><text x="216" y="504.39" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Investment, payback and what could go wrong</text><line x1="86.4" y1="525.12" x2="1193.57" y2="525.12" stroke="#C9D2DE" stroke-width="0.67"/><text x="110.4" y="580.3" font-family="Liberation Sans" font-size="37.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">05</text><text x="216" y="562.29" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Decision and next steps</text><text x="216" y="588.87" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">What we ask the board to approve today</text><line x1="86.4" y1="609.6" x2="1193.57" y2="609.6" stroke="#C9D2DE" stroke-width="0.67"/></svg>"`;

