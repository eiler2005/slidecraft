exports[`layout next-steps > example 0 (actions) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Six actions in the next 30 days put the German launch on track</text><line x1="57.6" y1="209.28" x2="804.25" y2="209.28" stroke="#0B1F3A" stroke-width="1.33"/><text x="65.28" y="198.64" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Next step</text><line x1="804.25" y1="209.28" x2="1043.17" y2="209.28" stroke="#0B1F3A" stroke-width="1.33"/><text x="811.93" y="198.64" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Owner</text><line x1="1043.17" y1="209.28" x2="1222.37" y2="209.28" stroke="#0B1F3A" stroke-width="1.33"/><text x="1050.85" y="198.64" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Due</text><line x1="57.6" y1="243.84" x2="804.25" y2="243.84" stroke="#C9D2DE" stroke-width="0.67"/><text x="65.28" y="232.52" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Confirm the phase-1 budget with the board and release the first tranche</text><line x1="804.25" y1="243.84" x2="1043.17" y2="243.84" stroke="#C9D2DE" stroke-width="0.67"/><text x="811.93" y="232.52" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">P. Nair</text><line x1="1043.17" y1="243.84" x2="1222.37" y2="243.84" stroke="#C9D2DE" stroke-width="0.67"/><text x="1050.85" y="232.52" font-family="Liberation Sans" font-si