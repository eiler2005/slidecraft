e-width="0.67"/><text x="433.95" y="300.4" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">8.0</text><line x1="465.73" y1="312.96" x2="643.18" y2="312.96" stroke="#C9D2DE" stroke-width="0.67"/><text x="600.8" y="300.4" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">11%</text><line x1="643.18" y1="312.96" x2="820.62" y2="312.96" stroke="#C9D2DE" stroke-width="0.67"/><text x="778.25" y="300.4" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">94%</text><text x="57.6" y="339.98" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Margin is contribution margin after support and success costs.</text><rect x="859.02" y="176.64" width="363.34" height="460.8" fill="#F2F5F9" stroke="none"/><rect x="859.02" y="176.64" width="5.76" height="460.8" fill="#1F5FBF" stroke="none"/><text x="887.82" y="224.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">SMB grows revenue but</text><text x="887.82" y="248.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">destroys value</text><text x="887.82" y="295.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="906.49" y="295.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Support cost per SMB account is</text><text x="906.49" y="317.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">3× the enterprise level</text><text x="887.82" y="350.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="906.49" y="350.58" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Net retention below 100% means</text><text x="906.49" y="372.98" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">growth depends on new logos</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source finance-fy25</text></svg>"`;

exports[`layout evidence-chain > example 0 (chain) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Four independent checks support releasing the new pricing to all regions</text><rect x="57.6" y="176.64" width="265.27" height="312" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="76.8" y="206.54" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">01</text><rect x="196.15" y="192" width="109.44" height="30.72" rx="15.36" fill="#2E7D5B" stroke="none"/><text x="220.87" y="211.52" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Confirmed</text><text x="76.8" y="253.83" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Conversion in pilot</text><text x="76.8" y="276.23" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">regions</text><text x="76.8" y="312.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">Conversion held at 3.1% vs 3.0%</text><text x="76.8" y="328.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">control; revenue per visit up 7%</text><line x1="76.8" y1="434.88" x2="303.67" y2="434.88" stroke="#C9D2DE" stroke-width="0.67"/><text x="76.8" y="453.26" font-family="Liberation Sans" font-size="13.33" font-style="italic" fill="#5B6B7F" xml:space="preserve">A/B test, 6 weeks, 41k visits</text><polygon points="328.63,321.12 349.75,332.64 328.63,344.16" fill="#5B6B7F" stroke="none"/><rect x="357.43" y="176.64" width="265.27" height="312" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="376.63" y="206.54" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">02</text><rect x="495.98" y="192" width="109.44" height="30.72" rx="15.36" fill="#2E7D5B" stroke="none"/><text x="520.7" y="211.52" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Confirmed</text><text x="376.63" y="253.83" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Churn of existing</text><text x="376.63" y="276.23" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">customers</text><text x="376.63" y="312.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">No change in monthly churn after the</text><text x="376.63" y="328.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">notice period</text><line x1="376.63" y1="434.88" x2="603.5" y2="434.88" stroke="#C9D2DE" stroke-width="0.67"/><text x="376.63" y="453.26" font-family="Liberation Sans" font-size="13.33" font-style="italic" fill="#5B6B7F" xml:space="preserve">Billing data, Q3</text><polygon points="628.46,321.12 649.58,332.64 628.46,344.16" fill="#5B6B7F" stroke="none"/><rect x="657.26" y="176.64" width="265.27" height="312" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="676.46" y="206.54" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">03</text><rect x="795.82" y="192" width="109.44" height="30.72" rx="15.36" fill="#9AB7E2" stroke="none"/><text x="833.86" y="211.52" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#111111" xml:space="preserve">Partly</text><text x="676.46" y="253.83" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Sales team readiness</text><text x="676.46" y="312.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">80% certified; the rest finish by 15</text><text x="676.46" y="328.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">November</text><line x1="676.46" y1="434.88" x2="903.34" y2="434.88" stroke="#C9D2DE" stroke-width="0.67"/><text x="676.46" y="453.26" font-family="Liberation Sans" font-size="13.33" font-style="italic" fill="#5B6B7F" xml:space="preserve">Training records</text><polygon points="928.3,321.12 949.42,332.64 928.3,344.16" fill="#5B6B7F" stroke="none"/><rect x="957.1" y="176.64" width="265.27" height="312" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="976.3" y="206.54" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">04</text><rect x="1095.65" y="192" width="109.44" height="30.72" rx="15.36" fill="#F2F5F9" stroke="#5B6B7F" stroke-width="1" stroke-dasharray="4 3"/><text x="1135.03" y="211.52" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#111111" xml:space="preserve">Open</text><text x="976.3" y="253.83" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Legal review in the EU</text><text x="976.3" y="312.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">Opinion expected next week for two</text><text x="976.3" y="328.14" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">markets</text><line x1="976.3" y1="434.88" x2="1203.17" y2="434.88" stroke="#C9D2DE" stroke-width="0.67"/><text x="976.3" y="453.26" font-family="Liberation Sans" font-size="13.33" font-style="italic" fill="#5B6B7F" xml:space="preserve">Counsel memo, Oct 2026</text><rect x="57.6" y="517.44" width="1164.77" height="76.8" fill="#1F5FBF" stroke="none"/><text x="86.4" y="562.31" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Therefore: </text><text x="183.9" y="562.31" font-family="Liberation Sans" font-size="18.67" fill="#FFFFFF" xml:space="preserve">Release in all regions on 1 December, with the two EU markets following the legal opinion</text><text x="57.6" y="614.54" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Unless: </text><text x="109.47" y="614.54" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">A negative legal opinion would hold those two markets on current prices</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source pricing-pilot</text></svg>"`;

exports[`layout exec-summary > example 0 (scr) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Entering Germany now captures a €40M window before two rivals scale</text><rect x="57.6" y="566.52" width="1164.77" height="70.92" fill="#1F5FBF" stroke="none"/><text x="81.6" y="608.45" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Decision requested:</text><text x="260.02" y="608.45" font-family="Liberation Sans" font-size="18.67" fill="#FFFFFF" xml:space="preserve"> Approve a €6M phase-1 budget and the partner shortlist at this meeting</text><text x="57.6" y="204.62" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">SITUATION</text><text x="275.73" y="205.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Our UK mid-market business grew 18% a year since 2022 and now funds itself; the product is proven in a</text><text x="275.73" y="228.23" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">regulated market.</text><line x1="57.6" y1="293.71" x2="1222.37" y2="293.71" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="321.69" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">COMPLICATION</text><text x="275.73" y="322.9" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Two well-funded competitors are preparing German launches in 2027, and switching costs make early share</text><text x="275.73" y="345.3" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">sticky.</text><line x1="57.6" y1="410.78" x2="1222.37" y2="410.78" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="438.76" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">RESOLUTION</text><text x="275.73" y="441.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Enter Germany in 2027 through a partner-led model, scaling direct sales only after 40 reference</text><text x="275.73" y="465.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">clients.</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source board-pack</text></svg>"`;

exports[`layout exec-summary > example 1 (key-messages) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Three facts make the case for a partner-led entry</text><text x="57.6" y="220.37" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">1</text><text x="124.8" y="207.09" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">The German mid-market is 3× our UK base and</text><text x="124.8" y="231.09" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">under-served</text><text x="655.84" y="205.83" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">41,000 firms in our segment; the top vendor holds under 12% share.</text><line x1="57.6" y1="330.24" x2="1222.37" y2="330.24" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="373.97" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">2</text><text x="124.8" y="360.69" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Partners cut time-to-first-revenue from 18 to 7</text><text x="124.8" y="384.69" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">months</text><text x="655.84" y="359.43" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Benchmarks from four comparable SaaS entries, 2019–2025.</text><line x1="57.6" y1="483.84" x2="1222.37" y2="483.84" stroke="#C9D2DE" stroke-width="1"/><text x="57.6" y="527.57" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#1F5FBF" xml:space="preserve">3</text><text x="124.8" y="514.29" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Phase 1 is self-limiting: €6M at risk, exit gates every</text><text x="124.8" y="538.29" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">quarter</text><text x="655.84" y="513.03" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Stop if fewer than 15 signed clients by Q4 2027.</text></svg>"`;

exports[`layout freeform > example 0 (body) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Three numbers tell the story of the first year</text><foreignObject x="57.6" y="176.64" width="1164.77" height="460.8"><div xmlns="http://www.w3.org/1999/xhtml" id="ff-scn3oq" class="sc-ff"><style>#ff-scn3oq{--ink:#0B1F3A;--muted:#5B6B7F;--accent:#1F5FBF;--accent-text:#FFFFFF;--accent-soft:#E3ECF9;--surface:#F2F5F9;--rule:#C9D2DE;--bg:#FFFFFF;--positive:#2E7D5B;--negative:#B23A3A;--font-heading:"Liberation Sans", Arial, sans-serif;--font-body:"Liberation Sans", Arial, sans-serif;--size-title:24pt;--size-heading:15pt;--size-body:14pt;--size-small:10pt;box-sizing:border-box;width:1164.77px;height:460.80px;overflow:hidden;font-family:var(--font-body);font-size:var(--size-body);line-height:1.25;color:var(--ink)}#ff-scn3oq *{box-sizing:border-box}#ff-scn3oq{.row{display:flex;gap:28px;height:100%;align-items:stretch}.cell{flex:1;background:var(--surface);border-top:6px solid var(--accent);padding:28px}.n{font-family:var(--font-heading);font-weight:700;font-size:64pt;line-height:1;color:var(--accent)}.l{margin-top:16px;font-size:var(--size-body);color:var(--ink)}.s{margin-top:8px;font-size:var(--size-small);color:var(--muted)}}</style><div class="row"><div class="cell"><div class="n">1 day</div><div class="l">to onboard a standard client</div><div class="s">down from 14 days</div></div><div class="cell"><div class="n">80%</div><div class="l">of checks run automatically</div><div class="s">the rest go to a specialist</div></div><div class="cell"><div class="n">2.1×</div><div class="l">more applications per adviser</div><div class="s">same team, same hours</div></div></div></div></foreignObject><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source ops-review</text></svg>"`;

