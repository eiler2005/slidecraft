exports[`layout architecture > example 0 (zones) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Two gaps in the order flow cause most failed orders; both have a known fix</text><rect x="57.6" y="176.64" width="204.4" height="260.16" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="72" y="200.78" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">CHANNELS</text><rect x="76.8" y="229.44" width="166" height="69.12" rx="4.8" fill="#FFFFFF" stroke="#C9D2DE" stroke-width="1.33"/><text x="127.95" y="268.62" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Web shop</text><rect x="76.8" y="346.56" width="166" height="69.12" rx="4.8" fill="#FFFFFF" stroke="#C9D2DE" stroke-width="1.33"/><text x="124.98" y="385.74" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Mobile app</text><rect x="310" y="176.64" width="204.4" height="260.16" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="324.4" y="200.78" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">SERVICES</text><rect x="329.2" y="229.44" width="166" height="69.12" rx="4.8" fill="#1F5FBF" stroke="#1F5FBF" stroke-width="1.33"/><text x="369.21" y="268.62" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Order service</text><rect x="329.2" y="346.56" width="166" height="69.12" rx="4.8" fill="#FFFFFF" stroke="#C9D2DE" stroke-width="1.33"/><text x="356.25" y="385.74" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Payment gateway</text><rect x="562.4" y="176.64" width="204.4" height="260.16" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="576.8" y="200.78" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">RECORDS</text><rect x="581.6" y="229.44" width="166" height="69.12" rx="4.8" fill="#FFFFFF" stroke="#C9D2DE" stroke-width="1.33"/><text x="650.89" y="268.62" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">ERP</text><rect x="581.6" y="346.56" width="166" height="69.12" rx="4.8" fill="#FFFFFF" stroke="#C9D2DE" stroke-width="1.33"/><text x="649.41" y="385.74" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">CRM</text><line x1="242.8" y1="264" x2="329.2" y2="264" stroke="#0B1F3A" stroke-width="1.33"/><polygon points="329.2,264 320.64,268.36 320.64,259.64" fill="#0B1F3A"/><line x1="234.28" y1="346.56" x2="337.72" y2="298.56" stroke="#0B1F3A" stroke-width="1.33"/><polygon points="337.72,298.56 331.79,306.11 328.13,298.21" fill="#0B1F3A"/><line x1="412.2" y1="298.56" x2="412.2" y2="346.56" stroke="#0B1F3A" stroke-width="1.33"/><polygon points="412.2,346.56 407.84,338.01 416.56,338.01" fill="#0B1F3A"/><line x1="495.2" y1="264" x2="581.6" y2="264" stroke="#0B1F3A" stroke-width="1.33"/><polygon points="581.6,264 573.04,268.36 573.04,259.64" fill="#0B1F3A"/><line x1="664.6" y1="298.56" x2="664.6" y2="346.56" stroke="#0B1F3A" stroke-width="1.33" stroke-dasharray="5.33 4"/><polygon points="664.6,346.56 660.24,338.01 668.95,338.01" fill="#0B1F3A"/><ellipse cx="493.28" cy="231.36" rx="14.4" ry="14.4" fill="#1F5FBF" stroke="none"/><text x="489.94" y="235.52" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#FFFFFF" xml:space="preserve">1</text><ellipse cx="745.67" cy="231.36" rx="14.4" ry="14.4" fill="#1F5FBF" stroke="none"/><text x="742.34" y="235.52" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#FFFFFF" xml:space="preserve">2</text><ellipse cx="819.59" cy="192.96" rx="14.4" ry="14.4" fill="#1F5FBF" stroke="none"/><text x="816.26" y="197.12" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#FFFFFF" xml:space="preserve">1</text><text x="845.51" y="194.31" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">No retry on payment timeouts</text><text x="845.51" y="223.82" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">2.1% of orders fail when the gateway is slow; add an</text><text x="845.51" y="239.82" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">idempotent retry with a 30-second window</text><ellipse cx="819.59" cy="303.36" rx="14.4" ry="14.4" fill="#1F5FBF" stroke="none"/><text x="816.26" y="307.52" font-family="Liberation Sans" font-size="12" font-weight="bold" fill="#FFFFFF" xml:space="preserve">2</text><text x="845.51" y="304.71" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Nightly ERP sync</text><text x="845.51" y="334.22" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Stock is up to 24 hours old; move to event-based updates for</text><text x="845.51" y="350.22" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">the 300 fastest-moving items</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source ops-review</text></svg>"`;

exports[`layout before-after > example 0 (panels) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Self-service onboarding turns a two-week paper chase into a same-day start</text><rect x="57.6" y="176.64" width="548.78" height="460.8" fill="#F2F5F9" stroke="none"/><text x="86.4" y="212.3" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">TODAY</text><line x1="86.4" y1="512.64" x2="577.58" y2="512.64" stroke="#C9D2DE" stroke-width="1"/><text x="86.4" y="567.08" font-family="Liberation Sans" font-size="45.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">14 days</text><text x="307.2" y="562.38" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Median days to first order</text><text x="86.4" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="105.07" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Customers email documents; staff re-key them into three</text><text x="105.07" y="283.91" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">systems</text><text x="86.4" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="105.07" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Credit checks wait in a shared inbox for two to three</text><text x="105.07" y="342.04" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">days</text><text x="86.4" y="377.78" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="105.07" y="377.78" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">One in five applications stalls on a missing signature</text><polygon points="621.74,376.32 658.22,407.04 621.74,437.76" fill="#1F5FBF" stroke="none"/><rect x="673.58" y="176.64" width="548.78" height="460.8" fill="#E3ECF9" stroke="none"/><rect x="673.58" y="176.64" width="548.78" height="5.76" fill="#1F5FBF" stroke="none"/><text x="702.38" y="212.3" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">WITH SELF-SERVICE</text><line x1="702.38" y1="512.64" x2="1193.57" y2="512.64" stroke="#C9D2DE" stroke-width="1"/><text x="702.38" y="567.08" font-family="Liberation Sans" font-size="45.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">1 day</text><text x="923.18" y="562.38" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Target median, standard cases</text><text x="702.38" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="721.05" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Customers upload once; data flows to CRM, ERP and</text><text x="721.05" y="283.91" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">billing</text><text x="702.38" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="721.05" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Automated checks clear 80% of applications in minutes</text><text x="702.38" y="355.38" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="721.05" y="355.38" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">E-signature and reminders close the remaining gaps</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source ops-review</text></svg>"`;

exports[`layout big-statement > example 0 (statement) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><svg xmlns="http://www.w3.org/2000/svg" x="0" y="0" width="1279.97" height="720" preserveAspectRatio="none" viewBox="0 0 2133 1200"><defs></defs><rect x="0" y="0" width="2133" height="9.6" fill="#1F5FBF"/></svg><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><text x="96" y="309.07" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#0B1F3A" xml:space="preserve">The next decade of retail banking</text><text x="96" y="379.47" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#0B1F3A" xml:space="preserve">will be won on trust, not on price</text><text x="96" y="458.4" font-family="Liberation Sans" font-size="24" fill="#5B6B7F" xml:space="preserve">Northwind customers who trust their bank hold twice as many products and switch</text><text x="96" y="487.2" font-family="Liberation Sans" font-size="24" fill="#5B6B7F" xml:space="preserve">half as often.</text><line x1="96" y1="207.52" x2="182.4" y2="207.52" stroke="#1F5FBF" stroke-width="5.33"/></svg>"`;

exports[`layout big-statement > example 1 (quote) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><svg xmlns="http://www.w3.org/2000/svg" x="0" y="0" width="1279.97" height="720" preserveAspectRatio="none" viewBox="0 0 2133 1200"><defs></defs><rect x="0" y="0" width="2133" height="9.6" fill="#1F5FBF"/></svg><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><text x="96" y="52.94" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">WHAT CUSTOMERS TOLD US</text><text x="92.16" y="272.04" font-family="Liberation Sans" font-size="173.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">“</text><text x="96" y="274.4" font-family="Liberation Sans" font-size="48" fill="#0B1F3A" xml:space="preserve">Before Contoso we spent two days a month</text><text x="96" y="332" font-family="Liberation Sans" font-size="48" fill="#0B1F3A" xml:space="preserve">reconciling accounts by hand. Now the close is</text><text x="96" y="389.6" font-family="Liberation Sans" font-size="48" fill="#0B1F3A" xml:space="preserve">finished before lunch on the first working day.</text><text x="96" y="499.72" font-family="Liberation Sans" font-size="21.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Maria Keller</text><text x="96" y="533.67" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Head of Finance, Tailspin Logistics</text><line x1="96" y1="444.96" x2="163.2" y2="444.96" stroke="#1F5FBF" stroke-width="4"/></svg>"`;

exports[`layout big-statement > example 2 (hero-number) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><svg xmlns="http://www.w3.org/2000/svg" x="0" y="0" width="1279.97" height="720" preserveAspectRatio="none" viewBox="0 0 2133 1200"><defs></defs><rect x="0" y="0" width="2133" height="9.6" fill="#1F5FBF"/></svg><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><line x1="96" y1="81.6" x2="153.6" y2="81.6" stroke="#1F5FBF" stroke-width="4"/><text x="96" y="125.01" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Every pilot site recovered its investment within a single year</text><text x="92.16" y="482.4" font-family="Liberation Sans" font-size="133.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">9 months</text><text x="755.84" y="391.77" font-family="Liberation Sans" font-size="29.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Average payback period across</text><text x="755.84" y="426.97" font-family="Liberation Sans" font-size="29.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">the twelve Fabrikam pilot sites</text><text x="755.84" y="473.8" font-family="Liberation Sans" font-size="21.33" fill="#5B6B7F" xml:space="preserve">The slowest site paid back in 14 months; the</text><text x="755.84" y="499.4" font-family="Liberation Sans" font-size="21.33" fill="#5B6B7F" xml:space="preserve">fastest in five.</text><line x1="722.24" y1="364" x2="722.24" y2="504.8" stroke="#C9D2DE" stroke-width="1.67"/></svg>"`;

