ze="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">sign-ups — at a fraction of</text><text x="919.88" y="296.37" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">the cost</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source finance-fy25</text></svg>"`;

exports[`layout funnel > example 1 (pyramid) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Data foundations come before AI: each level only works on the one beneath</text><text x="57.6" y="132.05" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">it</text><polygon points="364.8,176.64 364.8,176.64 441.6,286.08 288,286.08" fill="#84A7DC" stroke="none"/><line x1="446.4" y1="231.36" x2="697.92" y2="231.36" stroke="#C9D2DE" stroke-width="1"/><text x="705.6" y="226.97" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">AI-assisted decisions</text><text x="705.6" y="247.77" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">Forecasts and recommendations in the workflow</text><polygon points="288,293.76 441.6,293.76 518.4,403.2 211.2,403.2" fill="#A2BCE4" stroke="none"/><line x1="523.2" y1="348.48" x2="697.92" y2="348.48" stroke="#C9D2DE" stroke-width="1"/><text x="705.6" y="344.09" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Analytics and BI</text><text x="705.6" y="364.89" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">Trusted dashboards, one definition per metric</text><polygon points="211.2,410.88 518.4,410.88 595.2,520.32 134.4,520.32" fill="#C0D2ED" stroke="none"/><line x1="600" y1="465.6" x2="697.92" y2="465.6" stroke="#C9D2DE" stroke-width="1"/><text x="705.6" y="461.21" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Integrated data</text><text x="705.6" y="482.01" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">One customer and product record across systems</text><polygon points="134.4,528 595.2,528 672,637.44 57.6,637.44" fill="#1F5FBF" stroke="none"/><line x1="676.8" y1="582.72" x2="697.92" y2="582.72" stroke="#C9D2DE" stroke-width="1"/><text x="705.6" y="578.33" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">Data quality and governance</text><text x="705.6" y="599.13" font-family="Liberation Sans" font-size="17.33" fill="#5B6B7F" xml:space="preserve">Owners, rules and monitoring</text></svg>"`;

exports[`layout gate-matrix > example 0 (gates) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Each phase is funded only when the previous gate shows evidence, capping</text><text x="57.6" y="132.05" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">risk at €6M</text><rect x="57.6" y="204.48" width="1164.77" height="3.84" fill="#C9D2DE" stroke="none"/><rect x="57.6" y="176.64" width="244.26" height="59.52" rx="5.76" fill="#1F5FBF" stroke="none"/><text x="158.06" y="213.33" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Pilot</text><text x="57.6" y="270.89" font-family="Liberation Sans" font-size="11.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">DELIVERS</text><text x="57.6" y="303.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">15 partner-sourced clients</text><text x="57.6" y="326.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">live in two regions</text><text x="141.93" y="160.46" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">We are here</text><rect x="517.86" y="176.64" width="244.26" height="59.52" rx="5.76" fill="#D7E2F3" stroke="none"/><text x="571.06" y="213.33" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Scale partners</text><text x="517.86" y="270.89" font-family="Liberation Sans" font-size="11.