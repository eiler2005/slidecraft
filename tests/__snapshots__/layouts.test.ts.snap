nt-variant-ligatures="none"><text x="978.11" y="303.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Direct sales team for</text><text x="978.11" y="326.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">enterprise accounts</text></g></g><g data-sc-role="gate"><polygon points="409.86,171.84 444.42,206.4 409.86,240.96 375.3,206.4" fill="#0B1F3A" stroke="none"/></g><g font-kerning="none" font-variant-ligatures="none"><text x="406.15" y="211.02" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">1</text></g><g data-sc-role="gate-panel"><rect x="309.54" y="255.36" width="200.64" height="377.28" fill="#F2F5F9" stroke="none"/></g><g data-sc-pointer="/slides/0/gates/0/name"><g font-kerning="none" font-variant-ligatures="none"><text x="316.26" y="277.58" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">GATE 1</text></g></g><g data-sc-pointer="/slides/0/gates/0/criteria"><g font-kerning="none" font-variant-ligatures="none"><text x="316.26" y="312.09" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A">•</text><text x="334.92" y="312.09" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">≥ 15 signed clients</text><text x="316.26" y="338.22" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A">•</text><text x="334.92" y="338.22" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">Churn below 3% a</text><text x="334.92" y="359.02" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">quarter</text></g></g><g data-sc-pointer="/slides/0/gates/0/decider"><g font-kerning="none" font-variant-ligatures="none"><text x="316.26" y="611.02" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Decides:</text><text x="371.84" y="611.02" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve"> Board</text></g></g><g data-sc-role="gate"><polygon points="870.11,171.84 904.67,206.4 870.11,240.96 835.55,206.4" fill="#0B1F3A" stroke="none"/></g><g font-kerning="none" font-variant-ligatures="none"><text x="866.4" y="211.02" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">2</text></g><g data-sc-role="gate-panel"><rect x="769.79" y="255.36" width="200.64" height="377.28" fill="#F2F5F9" stroke="none"/></g><g data-sc-pointer="/slides/0/gates/1/name"><g font-kerning="none" font-variant-ligatures="none"><text x="776.51" y="277.58" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">GATE 2</text></g></g><g data-sc-pointer="/slides/0/gates/1/criteria"><g font-kerning="none" font-variant-ligatures="none"><text x="776.51" y="312.09" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A">•</text><text x="795.18" y="312.09" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">≥ 40 references</text><text x="776.51" y="338.22" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A">•</text><text x="795.18" y="338.22" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">CAC payback under</text><text x="795.18" y="359.02" font-family="Liberation Sans" font-size="17.33" fill="#0B1F3A" xml:space="preserve">18 months</text></g></g><g data-sc-pointer="/slides/0/gates/1/decider"><g font-kerning="none" font-variant-ligatures="none"><text x="776.51" y="611.02" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">Decides:</text><text x="832.09" y="611.02" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve"> Board + CFO</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source market-model</text></g></g></svg>"`;

exports[`layout issue-tree > example 0 (issue) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="accent-bar"><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Margin fell because of mix and price, not cost — two of six hypotheses hold</text></g></g><g data-sc-role="takeaway-band"><rect x="57.6" y="588.37" width="1164.77" height="49.07" fill="#F2F5F9" stroke="none"/></g><g data-sc-role="takeaway-accent"><rect x="57.6" y="588.37" width="5.76" height="49.07" fill="#1F5FBF" stroke="none"/></g><g data-sc-pointer="/slides/0/takeaway"><g font-kerning="none" font-variant-ligatures="none"><text x="81.6" y="619.38" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Fix discount governance and deal mix first; cost programmes would not move margin</text></g></g><g data-sc-role="node"><rect x="57.6" y="319.26" width="259.2" height="107.29" rx="5.76" fill="#1F5FBF" stroke="none"/></g><g data-sc-pointer="/slides/0/root/label"><g font-kerning="none" font-variant-ligatures="none"><text x="71.04" y="368.52" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Why did operating margin</text><text x="71.04" y="389.32" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">fall 4 points in FY2025?</text></g></g><line x1="316.8" y1="372.91" x2="343.2" y2="372.91" stroke="#5B6B