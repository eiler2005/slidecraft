y="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Mid-market shift to same-day</text><text x="78.72" y="522.31" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="97.39" y="522.31" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Retailers outsourcing last mile</text></g></g><g data-sc-role="panel"><rect x="455.88" y="428.16" width="384.84" height="209.28" fill="#F2F5F9" stroke="none"/></g><g font-kerning="none" font-variant-ligatures="none"><text x="477" y="454.22" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#5B6B7F" xml:space="preserve">THREATS</text></g><g data-sc-pointer="/slides/0/threats"><g font-kerning="none" font-variant-ligatures="none"><text x="477" y="491.91" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="495.66" y="491.91" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Low-cost entrants backed by €300M</text><text x="477" y="522.31" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="495.66" y="522.31" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Fuel and wage inflation 6–8% a year</text></g></g><g data-sc-role="panel"><rect x="874.32" y="176.64" width="348.05" height="460.8" fill="#F2F5F9" stroke="none"/></g><g data-sc-role="panel-accent"><rect x="874.32" y="176.64" width="5.76" height="460.8" fill="#1F5FBF" stroke="none"/></g><g font-kerning="none" font-variant-ligatures="none"><text x="903.12" y="212.3" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">SO WHAT</text></g><g data-sc-pointer="/slides/0/implications"><g font-kerning="none" font-variant-ligatures="none"><text x="903.12" y="253.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="921.78" y="253.83" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Launch same-day for mid-market</text><text x="921.78" y="276.23" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">in 2027 using our demand data</text><text x="903.12" y="311.96" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="921.78" y="311.96" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Cut cost per order 15% through</text><text x="921.78" y="334.36" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">route density before entrants</text><text x="921.78" y="356.76" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">scale</text><text x="903.12" y="392.5" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="921.78" y="392.5" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Build self-serve ordering to</text><text x="921.78" y="414.9" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">defend the small-customer base</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source ops-review</text></g></g></svg>"`;

