exports[`layout issue-tree > example 0 (issue) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Margin fell because of mix and price, not cost — two of six hypotheses hold</text><rect x="57.6" y="588.37" width="1164.77" height="49.07" fill="#F2F5F9" stroke="none"/><rect x="57.6" y="588.37" width="5.76" height="49.07" fill="#1F5FBF" stroke="none"/><text x="81.6" y="619.38" font-family="Liberation Sans" font-size="18.67" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Fix discount governance and deal mix first; cost programmes would not move margin</text><rect x="57.6" y="319.26" width="259.2" height="107.29" rx="5.76" fill="#1F5FBF" stroke="none"/><text x="71.04" y="368.52" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">Why did operating margin</text><text x="71.04" y="389.32" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#FFFFFF" xml:space="preserve">fall 4 points in FY2025?</text><line x1="316.8" y1="372.91" x2="343.2" y2="372.91" stroke="#5B6B7F" stroke-width="1.33"/><line x1="343.2" y1="242.06" x2="369.6" y2="242.06" stroke="#5B6B7F" stroke-width="1.33"/><rect x="369.6" y="212.3" width="297.6" height="59.52" rx="5.76" fill="#F2F5F9" stroke="none"/><text x="383.04" y="248.07" font-family="Liberation Sans" font-size="17.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Revenue mix shifted</text><ellipse cx="655.68" cy="223.82" rx="6.72" ry="6.72" fill="#2E7D5B" stroke="none"/><line x1="667.2" y1="242.06" x2="6