exports[`layout maturity-model > example 1 (staircase) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">We run AI pilots today; the next level is a shared platform with clear owners</text><rect x="57.6" y="447.36" width="282.55" height="190.08" fill="#F2F5F9" stroke="none"/><text x="74.88" y="493.62" font-family="Liberation Sans" font-size="34.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">1</text><text x="74.88" y="529.65" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Experiments</text><text x="74.88" y="586.7" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Individual teams try tools; no shared data</text><text x="74.88" y="602.7" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">or rules</text><rect x="351.67" y="369.92" width="282.55" height="267.52" fill="#E3ECF9" stroke="none"/><text x="368.95" y="416.18" font-family="Liberation Sans" font-size="34.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">2</text><text x="368.95" y="452.21" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Pilots</text><text x="368.95" y="509.26" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Funded pilots with business owners and</text><text x="368.95" y="525.26" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">success metrics</text><text x="351.67" y="358.86" fon