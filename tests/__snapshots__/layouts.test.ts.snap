.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Customers email documents; staff re-key them into three</text><text x="105.07" y="283.91" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">systems</text><text x="86.4" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="105.07" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Credit checks wait in a shared inbox for two to three</text><text x="105.07" y="342.04" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">days</text><text x="86.4" y="377.78" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="105.07" y="377.78" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">One in five applications stalls on a missing signature</text></g></g><g data-sc-role="arrow"><polygon points="621.74,376.32 658.22,407.04 621.74,437.76" fill="#1F5FBF" stroke="none"/></g><g data-sc-role="panel"><rect x="673.58" y="176.64" width="548.78" height="460.8" fill="#E3ECF9" stroke="none"/></g><g data-sc-role="accent-rule"><rect x="673.58" y="176.64" width="548.78" height="5.76" fill="#1F5FBF" stroke="none"/></g><g data-sc-pointer="/slides/0/after/label"><g font-kerning="none" font-variant-ligatures="none"><text x="702.38" y="212.3" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">WITH SELF-SERVICE</text></g></g><line x1="702.38" y1="512.64" x2="1193.57" y2="512.64" stroke="#C9D2DE" stroke-width="1"/><g data-sc-pointer="/slides/0/after/metric/value"><g font-kerning="none" font-variant-ligatures="none"><text x="702.38" y="567.08" font-family="Liberation Sans" font-size="45.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">1 day</text></g></g><g data-sc-pointer="/slides/0/after/metric/label"><g font-kerning="none" font-variant-ligatures="none"><text x="923.18" y="562.38" font-family="Liberation Sans" font-size="13.33" fill="#5B6B7F" xml:space="preserve">Target median, standard cases</text></g></g><g data-sc-pointer="/slides/0/after/items"><g font-kerning="none" font-variant-ligatures="none"><text x="702.38" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="721.05" y="261.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Customers upload once; data flows to CRM, ERP and</text><text x="721.05" y="283.91" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">billing</text><text x="702.38" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="721.05" y="319.64" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Automated checks clear 80% of applications in minutes</text><text x="702.38" y="355.38" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="721.05" y="355.38" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">E-signature and reminders close the remaining gaps</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source ops-review</text></g></g></svg>"`;

exports[`layout big-statement > example 0 (statement) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><g data-sc-role="decor"><svg xmlns="http://www.w3.org/2000/svg" x="0" y="0" width="1279.97" height="720" preserveAspectRatio="none" viewBox="0 0 2133 1200"><defs></defs><rect x="0" y="0" width="2133" height="9.6" fill="#1F5FBF"/></svg></g><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="96" y="309.07" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#0B1F3A" xml:space="preserve">The next decade of retail banking</text><text x="96" y="379.47" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#0B1F3A" xml:space="preserve">will be won on trust, not on price</text></g></g><g data-sc-role="support" data-sc-pointer="/slides/0/support"><g font-kerning="none" font-variant-ligatures="none"><text x="96" y="458.4" font-family="Liberation Sans" font-size="24" fill="#5B6B7F" xml:space="preserve">Northwind customers who trust their bank hold twice as many products and switch</text><text x="96" y="487.2" font-family="Liberation Sans" font-size="24" fill="#5B6B7F" xml:space="preserve">half as often.</text></g></g><line x1="96" y1="207.52" x2="182.4" y2="207.52" stroke="#1F5FBF" stroke-width="5.33"/></svg>"`;

exports[`layout big-statement > example 1 (quote) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><g data-sc-role="decor"><svg xmlns="http://www.w3.org/2000/svg" x="0" y="0" width="1279.97" height="720" preserveAspectRatio="none" viewBox="0 0 2133 1200"><defs></defs><rect x="0" y="0" width="2133" height="9.6" fill="#1F5FBF"/></svg></g><text data-sc-role="page-number" x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><g data-sc-role="title" data-sc-pointer="/slides/0/title"><g font-kerning="none" font-variant-ligatures="none"><text x="96" y="52.94" font-family="Liberation Sans" font-size="13.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">WHAT CUSTOMERS TOLD US</text></g></g><g data-sc-role="quote-mark"><g font-kerning="none" font-variant-ligatures="none"><text x="92.16" y="272.04" font-family="Liberation Sans" font-size="173.33" font-weight="bold" fill="#1F5FBF" xml:space="preserve">“</text></g></g><g data-sc-role="quote" data-sc-pointer="/slides/0/quote"><g font-kerning="none" font-variant-ligatures="none"><text x="96" y="274.4" font-family="Liberation Sans" font-size="48" fill="#0B1F3A" xml:space="preserve">Before Contoso we spent two days a month</text><text x="96" y="332" font-family="Liberation Sans" font-size="48" fill="#0B1F3A" xml:space="preserve">reconciling accounts by hand. Now the close is</text><text x="96" y="389.6" font-family="Liberation Sans" font-size="48" fill="#0B1F3A" xml:space="preserve">finished before lunch on the first working day.</text></g></g><g data-sc-role="attribution" data-sc-pointer="/slides/0/attribution"><g font-kerning="none" font-variant-ligatures="none"><text x="96" y="499.72" font-family="Liberation Sans" font-size="21.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Maria Keller</text></g></g><g data-sc-role="role" data-sc-pointer="/slides/0/role"><g font-kerning="none" font-variant-ligatures="none"><text x="96" y="533.67" font-family="Liberation Sans" font-size="18.67" fill="#5B6B7F" xml:space="preserve">Head of Finance, Tailspin Logistics</text></g></g><line x1="96" y1="444.96" x2="163.2" y2="444.96" stroke="#1F5FBF" stroke-width="4"/></svg>"`;

