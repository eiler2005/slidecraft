<text x="887.82" y="295.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="906.49" y="295.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Payment terms for enterprise</text><text x="906.49" y="317.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">clients stretched from 45 to 72</text><text x="906.49" y="339.91" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">days</text><text x="887.82" y="372.98" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A">•</text><text x="906.49" y="372.98" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Without the working-capital swing,</text><text x="906.49" y="395.38" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">free cash flow would be +€5M</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source finance-fy25</text></svg>"`;
