exports[`layout process-steps > example 1 (numbered) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Our diagnostic moves from data to decisions in five weeks</text><text x="57.6" y="224.61" font-family="Liberation Sans" font-size="50.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">01</text><line x1="158.4" y1="217.44" x2="348.79" y2="217.44" stroke="#C9D2DE" stroke-width="1.33"/><polygon points="348.79,217.44 340.24,221.8 340.24,213.08" fill="#C9D2DE"/><text x="57.6" y="286.77" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Frame the question</text><text x="57.6" y="352.71" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Agree the decision, scope and</text><text x="57.6" y="375.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">hypotheses with the sponsor in</text><text x="57.6" y="397.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">week one</text><text x="358.39" y="224.61" font-family="Liberation Sans" font-size="50.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">02</text><line x1="459.19" y1="217.44" x2="649.58" y2="217.44" stroke="#C9D2DE" stroke-width="1.33"/><polygon points="649.58,217.44 641.03,221.8 641.03,213.08" fill="#C9D2DE"/><text x="358.39" y="286.77" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Gather evidence</text><text x="358.39" y="352.71" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Interviews, finance data and a</text><text x="358.39" y="375.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">customer survey run in parallel</text><text x="659.18" y="224.61" font-family="Liberation Sans" font-size="50.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">03</text><line x1="759.98" y1="217.44" x2="950.38" y2="217.44" stroke="#C9D2DE" stroke-width="1.33"/><polygon points="950.38,217.44 941.82,221.8 941.82,213.08" fill="#C9D2DE"/><text x="659.18" y="286.77" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Analyse</text><text x="659.18" y="352.71" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Test each hypothesis; kill the</text><text x="659.18" y="375.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">ones the data does not support</text><text x="959.98" y="224.61" font-family="Liberation Sans" font-size="50.67" font-weight="bold" fill="#1F5FBF" xml:space="preserve">04</text><text x="959.98" y="286.77" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Recommend</text><text x="959.98" y="352.71" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Synthesis workshop and a</text><text x="959.98" y="375.11" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">board-ready recommendation</text><text x="959.98" y="397.51" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">in week five</text></svg>"`;

