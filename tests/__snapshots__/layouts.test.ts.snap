exports[`layout key-points > example 0 (columns) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Three strengths make Contoso a credible partner for the German launch</text><line x1="57.6" y1="176.64" x2="410.66" y2="176.64" stroke="#1F5FBF" stroke-width="3.33"/><text x="57.6" y="259.63" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">+18%</text><text x="57.6" y="328.96" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Revenue has compounded for</text><text x="57.6" y="357.76" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">four years</text><line x1="463.46" y1="176.64" x2="816.51" y2="176.64" stroke="#1F5FBF" stroke-width="3.33"/><text x="463.46" y="259.63" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">9 in 10</text><text x="463.46" y="328.96" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Clients renew after the first</text><text x="463.46" y="357.76" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">year</text><line x1="869.31" y1="176.64" x2="1222.37" y2="176.64" stroke="#1F5FBF" stroke-width="3.33"/><text x="869.31" y="259.63" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">12</text><text x="869.31" y="328.96" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Integration partners already</text><text x="869.31" y="357.76" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">operate in DACH</text><text x="57.6" y="400.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">Contoso grew 18% a year since 2022</text><text x="57.6" y="424.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">and funds its own expansion without</text><text x="57.6" y="448.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">new capital.</text><text x="463.46" y="400.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">Renewal is highest among regulated</text><text x="463.46" y="424.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">customers, the segment we target in</text><text x="463.46" y="448.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">Germany.</text><text x="869.31" y="400.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">Existing alliances cover three of the five</text><text x="869.31" y="424.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">largest German system integrators.</text><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source contoso-annual</text></svg>"`;

exports[`layout key-points > example 1 (cards) composes cleanly in consulting-classic 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="1279.97" height="720" viewBox="0 0 1279.97 720"><rect width="1279.97" height="720" fill="#FFFFFF"/><text x="1222.37" y="685.44" text-anchor="end" font-family="Liberation Sans" font-size="11.33" fill="#5B6B7F">1</text><rect x="57.6" y="57.6" width="52.8" height="4.8" fill="#1F5FBF" stroke="none"/><text x="57.6" y="96.21" font-family="Liberation Sans" font-size="32" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Northwind wins on speed, coverage and cost against regional rivals</text><rect x="57.6" y="176.64" width="269.59" height="460.8" fill="#F2F5F9" stroke="none"/><rect x="57.6" y="176.64" width="269.59" height="5.76" fill="#1F5FBF" stroke="none"/><text x="81.6" y="260.59" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">6 wks</text><text x="81.6" y="327.4" font-family="Liberation Sans" font-size="21.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Speed to value</text><rect x="355.99" y="176.64" width="269.59" height="460.8" fill="#F2F5F9" stroke="none"/><rect x="355.99" y="176.64" width="269.59" height="5.76" fill="#1F5FBF" stroke="none"/><text x="379.99" y="260.59" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">3 areas</text><text x="379.99" y="327.4" font-family="Liberation Sans" font-size="21.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Coverage</text><rect x="654.38" y="176.64" width="269.59" height="460.8" fill="#F2F5F9" stroke="none"/><rect x="654.38" y="176.64" width="269.59" height="5.76" fill="#1F5FBF" stroke="none"/><text x="678.38" y="260.59" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">-24%</text><text x="678.38" y="327.4" font-family="Liberation Sans" font-size="21.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Total cost</text><rect x="952.78" y="176.64" width="269.59" height="460.8" fill="#F2F5F9" stroke="none"/><rect x="952.78" y="176.64" width="269.59" height="5.76" fill="#1F5FBF" stroke="none"/><text x="976.78" y="260.59" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">24/7</text><text x="976.78" y="327.4" font-family="Liberation Sans" font-size="21.33" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Support</text><text x="81.6" y="367.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Clients go live in 6 weeks</text><text x="81.6" y="390.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">against an industry norm</text><text x="81.6" y="412.55" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">of 5 months.</text><text x="379.99" y="367.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">One platform serves</text><text x="379.99" y="390.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">finance, supply chain and</text><text x="379.99" y="412.55" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">HR without separate</text><text x="379.99" y="434.95" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">contracts.</text><text x="678.38" y="367.75" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">Three-year cost of</text><text x="678.38" y="390.15" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">ownership is a quarter</text><text x="678.38" y="412.55" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">below the closest</text><text x="678.38" y="434.95" font-family="Liberation Sans" font-size="18.67" fill="#0B1F3A" xml:space="preserve">competitor.</text><text x="976.78" y=