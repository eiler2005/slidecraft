3.33" fill="#0B1F3A" xml:space="preserve">Top five hold 31% share; long tail of small fleets</text><text x="482.98" y="423.18" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A">•</text><text x="501.64" y="423.18" font-family="Liberation Sans" font-size="13.33" fill="#0B1F3A" xml:space="preserve">Price wars only on long-haul lanes</text></g></g><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="186.74" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Rating = strength of the force; high squeezes profit</text></g><g data-sc-role="panel"><rect x="866.11" y="504.32" width="356.26" height="133.12" fill="#F2F5F9" stroke="none"/></g><g data-sc-role="panel-accent"><rect x="866.11" y="504.32" width="5.76" height="133.12" fill="#1F5FBF" stroke="none"/></g><g data-sc-pointer="/slides/0/takeaway"><g font-kerning="none" font-variant-ligatures="none"><text x="894.91" y="539.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Enter now: margins hold at</text><text x="894.91" y="563.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">9–11% while rail is a threat only</text><text x="894.91" y="587.23" font-family="Liberation Sans" font-size="20" font-weight="bold" fill="#0B1F3A" xml:space="preserve">on the main corridors</text></g></g><g data-sc-role="source" data-sc-pointer="/slides/0/sources"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="653.94" font-family="Liberation Sans" font-size="10.67" fill="#5B6B7F" xml:space="preserve">Illustrative data. Source: Source market-est</text></g></g></svg>"`;

