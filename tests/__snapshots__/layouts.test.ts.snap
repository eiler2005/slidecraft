 data-sc-pointer="/slides/0/points/1/heading"><g font-kerning="none" font-variant-ligatures="none"><text x="463.46" y="328.96" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Clients renew after the first</text><text x="463.46" y="357.76" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">year</text></g></g><line x1="869.31" y1="176.64" x2="1222.37" y2="176.64" stroke="#1F5FBF" stroke-width="3.33"/><g data-sc-role="metric" data-sc-pointer="/slides/0/points/2/metric"><g font-kerning="none" font-variant-ligatures="none"><text x="869.31" y="259.63" font-family="Liberation Sans" font-size="64" font-weight="bold" fill="#1F5FBF" xml:space="preserve">12</text></g></g><g data-sc-role="heading" data-sc-pointer="/slides/0/points/2/heading"><g font-kerning="none" font-variant-ligatures="none"><text x="869.31" y="328.96" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">Integration partners already</text><text x="869.31" y="357.76" font-family="Liberation Sans" font-size="24" font-weight="bold" fill="#0B1F3A" xml:space="preserve">operate in DACH</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/0/body"><g font-kerning="none" font-variant-ligatures="none"><text x="57.6" y="400.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">Contoso grew 18% a year since 2022</text><text x="57.6" y="424.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">and funds its own expansion without</text><text x="57.6" y="448.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">new capital.</text></g></g><g data-sc-role="body" data-sc-pointer="/slides/0/points/1/body"><g font-kerning="none" font-variant-ligatures="none"><text x="463.46" y="400.05" font-family="Liberation Sans" font-size="20" fill="#0B1F3A" xml:space="preserve">Renewal i